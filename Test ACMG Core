def test_parse_frequency_returns_none_when_no_gnomad_block():
    freq = parse_frequency({"dbnsfp": {"genename": "EYS"}})
    assert freq.in_gnomad is False
    assert freq.effective_af is None


def test_parse_frequency_reads_an_hom_and_af():
    payload = {
        "gnomad_exome": {
            "af": {"af": 2.72e-4, "af_afr": 1.0e-4, "af_sas": 9.9e-4},
            "an": {"an": 1_400_000},
            "hom": {"hom": 0},
        }
    }
    freq = parse_frequency(payload)
    assert freq.in_gnomad is True
    assert abs(freq.popmax_af - 9.9e-4) < 1e-12      # popmax across populations
    assert freq.allele_number == 1_400_000
    assert freq.adequately_covered is True
    assert freq.uses_point_estimate is True          # no FAF95 in the payload


