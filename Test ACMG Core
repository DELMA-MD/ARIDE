def test_assessment_lists_unassessed_criteria():
    result = assess_annotation(
        FrequencyEvidence(popmax_af=1e-6, allele_number=1_400_000),
        InSilicoEvidence(revel=0.80), MolecularClass.MISSENSE, AR)
    joined = " ".join(result.caveats)
    for code in ("PS3", "PM3", "PP1", "PM1"):
        assert code in joined


def test_truncating_variant_does_not_auto_apply_pvs1():
    result = assess_annotation(
        FrequencyEvidence(popmax_af=0.0, allele_number=1_400_000),
        InSilicoEvidence(), MolecularClass.TRUNCATING, AR)
    assert "PVS1" not in [e.code for e in result.evidence]
    assert any("NMD decision tree" in c for c in result.caveats)


def test_inframe_indel_needs_repeat_context():
    freq = FrequencyEvidence(popmax_af=0.0, allele_number=1_400_000)
    unknown = assess_annotation(freq, InSilicoEvidence(), MolecularClass.INFRAME_INDEL, AR)
    assert "PM4" not in [e.code for e in unknown.evidence]
    assert any("repeat" in c for c in unknown.caveats)

    non_repeat = assess_annotation(freq, InSilicoEvidence(), MolecularClass.INFRAME_INDEL,
                                   AR, in_repeat_region=False)
    assert "PM4" in [e.code for e in non_repeat.evidence]

    repeat = assess_annotation(freq, InSilicoEvidence(), MolecularClass.INFRAME_INDEL,
                               AR, in_repeat_region=True)
    assert "BP3" in [e.code for e in repeat.evidence]


