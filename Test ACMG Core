# 8. REVEL bands, including the previously missing Very Strong benign
# ---------------------------------------------------------------------

def test_revel_pathogenic_bands():
    for score, strength in [(0.95, Strength.STRONG), (0.80, Strength.MODERATE),
                            (0.70, Strength.SUPPORTING)]:
        line, _ = evaluate_missense_insilico(InSilicoEvidence(revel=score))
        assert line is not None and line.code == "PP3" and line.strength is strength


def test_revel_benign_bands_including_very_strong():
    for score, strength in [(0.002, Strength.VERY_STRONG), (0.010, Strength.STRONG),
                            (0.10, Strength.MODERATE), (0.25, Strength.SUPPORTING)]:
        line, _ = evaluate_missense_insilico(InSilicoEvidence(revel=score))
        assert line is not None and line.code == "BP4", score
        assert line.strength is strength, (score, line.strength)
    assert REVEL_BP4_VERY_STRONG == 0.003


def test_revel_indeterminate_band_yields_nothing():
    line, notes = evaluate_missense_insilico(InSilicoEvidence(revel=0.45))
    assert line is None
    assert any("indeterminate" in n for n in notes)


def test_alphamissense_used_only_when_revel_absent():
    both = InSilicoEvidence(revel=0.95, alphamissense=0.01)
    line, _ = evaluate_missense_insilico(both)
    assert line.code == "PP3"                        # REVEL wins, not a vote

    alpha_only = InSilicoEvidence(alphamissense=ALPHAMISSENSE_BENIGN - 0.01)
    line, _ = evaluate_missense_insilico(alpha_only)
    assert line.code == "BP4" and line.strength is Strength.SUPPORTING


def test_cadd_never_generates_a_criterion():
    line, notes = evaluate_missense_insilico(InSilicoEvidence(cadd_phred=35.0))
    assert line is None
    assert any("No calibrated missense predictor" in n for n in notes)


# ---------------------------------------------------------------------
# 9. dbscSNV is scored on its own scale, not SpliceAI's
# ---------------------------------------------------------------------

def test_dbscsnv_uses_its_own_cutoff():
    """0.55 is below dbscSNV's 0.6 cutoff but above SpliceAI's 0.5 — the
    original code would have called it splice-altering."""
    assert DBSCSNV_CUTOFF == 0.6
    line, _ = evaluate_splice_insilico(InSilicoEvidence(dbscsnv_max=0.55))
    assert line.code == "BP4"
    line, _ = evaluate_splice_insilico(InSilicoEvidence(dbscsnv_max=0.75))
    assert line.code == "PP3" and line.strength is Strength.SUPPORTING


def test_spliceai_preferred_over_dbscsnv():
    both = InSilicoEvidence(spliceai_delta=0.85, dbscsnv_max=0.10)
    line, _ = evaluate_splice_insilico(both)
    assert line.code == "PP3" and line.strength is Strength.MODERATE
    assert "SpliceAI" in line.note


# ---------------------------------------------------------------------
# 10. BP7 requires both arms
# ---------------------------------------------------------------------

def test_bp7_requires_splice_quiet_and_low_conservation():
    quiet_unconserved = InSilicoEvidence(spliceai_delta=0.02, phylop=0.3)
    result = assess_annotation(
        FrequencyEvidence(popmax_af=0.0, allele_number=1_400_000),
        quiet_unconserved, MolecularClass.SYNONYMOUS, AR)
    assert "BP7" in [e.code for e in result.evidence]

    quiet_conserved = InSilicoEvidence(spliceai_delta=0.02, phylop=5.0)
    result = assess_annotation(
        FrequencyEvidence(popmax_af=0.0, allele_number=1_400_000),
        quiet_conserved, MolecularClass.SYNONYMOUS, AR)
    assert "BP7" not in [e.code for e in result.evidence]
    assert any("conserved" in c for c in result.caveats)


