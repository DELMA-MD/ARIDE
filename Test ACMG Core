"""
test_acmg_core.py — regression tests for each defect fixed in the refactor.

Run:  python -m pytest test_acmg_core.py -v
  or: python test_acmg_core.py      (falls back to a plain runner)
"""

from __future__ import annotations

import math

from acmg_core import (
    ALPHAMISSENSE_BENIGN, BA1_ALLELE_FREQUENCY, DBSCSNV_CUTOFF,
    MIN_ALLELE_NUMBER_FOR_ABSENCE, REVEL_BP4_VERY_STRONG,
    Classification, DiseaseModel, EvidenceLine, FrequencyEvidence, GeneValidity,
    InSilicoEvidence, Inheritance, MolecularClass, PipelineResult, Strength,
    VUSResolutionPipeline, VariantCase, Zygosity,
    assess_annotation, classify_from_points, evaluate_frequency,
    evaluate_missense_insilico, evaluate_splice_insilico, parse_frequency,
    check_mutual_exclusivity,
)

AR = DiseaseModel(name="AR inherited retinal disease", inheritance=Inheritance.AR)
AD = DiseaseModel(name="AD inherited retinal disease", inheritance=Inheritance.AD)


# ---------------------------------------------------------------------
# 1. The Strength enum alias bug
# ---------------------------------------------------------------------

def test_standalone_is_not_an_alias_for_very_strong():
    """The original code had VERY_STRONG = 8 and STAND_ALONE = 8, which Python
    collapses into aliases, so every PVS1 was reported as 'stand-alone'."""
    assert Strength.STAND_ALONE is not Strength.VERY_STRONG
    assert Strength.STAND_ALONE.label == "StandAlone"
    assert Strength.VERY_STRONG.label == "VeryStrong"
    assert len(list(Strength)) == 5


def test_pvs1_very_strong_is_not_reported_as_standalone():
    pvs1 = EvidenceLine("PVS1", Strength.VERY_STRONG, "Step3a")
    assert pvs1.is_standalone is False
    assert pvs1.points == 8
    assert pvs1.points_display == "+8"

    ba1 = EvidenceLine("BA1", Strength.STAND_ALONE, "Step1")
    assert ba1.is_standalone is True
    assert ba1.points_display == "Stand-alone"


# ---------------------------------------------------------------------
# 2. Classification bands, including the LB/B split at -7
# ---------------------------------------------------------------------

def test_classification_bands():
    assert classify_from_points(12) is Classification.PATHOGENIC
    assert classify_from_points(10) is Classification.PATHOGENIC
    assert classify_from_points(9) is Classification.LIKELY_PATHOGENIC
    assert classify_from_points(6) is Classification.LIKELY_PATHOGENIC
    assert classify_from_points(5) is Classification.VUS
    assert classify_from_points(0) is Classification.VUS


def test_likely_benign_and_benign_are_separate():
    """The original collapsed everything <= -1 into 'Likely Benign / Benign'."""
    assert classify_from_points(-1) is Classification.LIKELY_BENIGN
    assert classify_from_points(-4) is Classification.LIKELY_BENIGN   # one BS1
    assert classify_from_points(-6) is Classification.LIKELY_BENIGN
    assert classify_from_points(-7) is Classification.BENIGN
    assert classify_from_points(-8) is Classification.BENIGN          # two Strong benign


# ---------------------------------------------------------------------
# 3. Retired criteria and mutual exclusivity
# ---------------------------------------------------------------------

def test_retired_codes_are_rejected():
    for code in ("PP5", "BP6"):
        try:
            EvidenceLine(code, Strength.SUPPORTING, "test")
        except ValueError as exc:
            assert "retired" in str(exc).lower()
        else:
            raise AssertionError(f"{code} should have been rejected")


def test_unknown_code_rejected():
    try:
        EvidenceLine("PX9", Strength.SUPPORTING, "test")
    except ValueError:
        pass
    else:
        raise AssertionError("PX9 should have been rejected")


def test_mutual_exclusivity_detected():
    conflicts = check_mutual_exclusivity([
        EvidenceLine("PM4", Strength.MODERATE, "x"),
        EvidenceLine("BP3", Strength.SUPPORTING, "x"),
    ])
    assert len(conflicts) == 1 and "PM4" in conflicts[0]


# ---------------------------------------------------------------------
# 4. Maximum credible allele frequency (Whiffin 2017)
# ---------------------------------------------------------------------

def test_max_credible_af_is_gene_and_disease_specific():
    ar = AR.max_credible_af
    ad = AD.max_credible_af
    # AR ceiling is far above the hardcoded 1e-4 the original used...
    assert ar > 1e-3, ar
    # ...and the AD ceiling is far below it.
    assert ad < 1e-5, ad
    assert ar > ad


def test_max_credible_af_matches_the_formula():
    d = DiseaseModel(inheritance=Inheritance.AR, prevalence=1 / 3000,
                     max_gene_contribution=0.10, max_allelic_contribution=0.05,
                     penetrance=1.0)
    expected = math.sqrt((1 / 3000) * 0.10 * 0.05)
    assert abs(d.max_credible_af - expected) < 1e-12


def test_bs1_uses_the_disease_ceiling_not_a_constant():
    """AF 2.72e-4 — the rs749219852 case from the screenshot. Under the old
    hardcoded 1e-4 it triggered BS1; under an AR retinal ceiling it does not."""
    freq = FrequencyEvidence(popmax_af=2.72e-4, allele_number=1_400_000)
    ar_lines, _ = evaluate_frequency(freq, AR)
    ad_lines, _ = evaluate_frequency(freq, AD)
    assert [e.code for e in ar_lines] == []          # below the AR ceiling
    assert "BS1" in [e.code for e in ad_lines]       # above the AD ceiling


# ---------------------------------------------------------------------
# 5. BA1 terminality
# ---------------------------------------------------------------------

def test_ba1_is_terminal_and_stops_evaluation():
    freq = FrequencyEvidence(popmax_af=0.08, allele_number=1_400_000, hom_count=50)
    lines, _ = evaluate_frequency(freq, AR)
    assert [e.code for e in lines] == ["BA1"]        # BS2 never evaluated
    assert lines[0].is_standalone

    assessment = assess_annotation(freq, InSilicoEvidence(revel=0.95),
                                   MolecularClass.MISSENSE, AR)
    assert assessment.standalone
    assert assessment.classification is Classification.BENIGN
    assert assessment.total_points is None           # not netted against PP3


def test_ba1_threshold_is_five_percent():
    assert BA1_ALLELE_FREQUENCY == 0.05
    just_under = FrequencyEvidence(popmax_af=0.049, allele_number=1_400_000)
    lines, _ = evaluate_frequency(just_under, AR)
    assert [e.code for e in lines] == ["BS1"]


# ---------------------------------------------------------------------
# 6. PM2 coverage gating
# ---------------------------------------------------------------------

def test_pm2_not_awarded_when_gnomad_record_is_missing():
    """The original returned 0.0 for a missing gnomAD block and awarded PM2."""
    missing = FrequencyEvidence()                    # popmax_af is None
    lines, caveats = evaluate_frequency(missing, AR)
    assert lines == []
    assert any("not assessed" in c for c in caveats)


def test_pm2_not_awarded_at_low_coverage():
    shallow = FrequencyEvidence(popmax_af=0.0, allele_number=1_000)
    lines, caveats = evaluate_frequency(shallow, AR)
    assert [e.code for e in lines] == []
    assert any("allele number" in c for c in caveats)


def test_pm2_awarded_as_supporting_at_adequate_coverage():
    """ClinGen SVI 2020 downgrades PM2 from Moderate to Supporting."""
    covered = FrequencyEvidence(popmax_af=0.0,
                                allele_number=MIN_ALLELE_NUMBER_FOR_ABSENCE + 1)
    lines, _ = evaluate_frequency(covered, AR)
    assert len(lines) == 1
    assert lines[0].code == "PM2"
    assert lines[0].strength is Strength.SUPPORTING
    assert lines[0].points == 1                      # not 2


# ---------------------------------------------------------------------
# 7. BS2
# ---------------------------------------------------------------------

def test_bs2_scales_with_homozygote_count():
    one = FrequencyEvidence(popmax_af=1e-4, allele_number=1_400_000, hom_count=1)
    two = FrequencyEvidence(popmax_af=1e-4, allele_number=1_400_000, hom_count=2)
    assert [e.strength for e in evaluate_frequency(one, AR)[0] if e.code == "BS2"] == [Strength.SUPPORTING]
    assert [e.strength for e in evaluate_frequency(two, AR)[0] if e.code == "BS2"] == [Strength.STRONG]


def test_bs2_not_auto_applied_for_dominant_disease():
    freq = FrequencyEvidence(popmax_af=1e-6, allele_number=1_400_000, hom_count=0)
    lines, caveats = evaluate_frequency(freq, AD)
    assert "BS2" not in [e.code for e in lines]
    assert any("age-matched" in c for c in caveats)


