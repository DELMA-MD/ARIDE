# 13. The pipeline actually runs now
# ---------------------------------------------------------------------

def _base_case(**kw) -> VariantCase:
    defaults = dict(
        variant_id="TEST:c.1A>G",
        gene="TESTGENE",
        inheritance=Inheritance.AR,
        gene_validity=GeneValidity.DEFINITIVE,
        molecular_class=MolecularClass.MISSENSE,
        disease=AR,
        frequency=FrequencyEvidence(popmax_af=0.0, allele_number=1_400_000),
        insilico=InSilicoEvidence(revel=0.95),
        zygosity=Zygosity.COMP_HET_AR,
    )
    defaults.update(kw)
    return VariantCase(**defaults)


def test_pipeline_runs_end_to_end():
    result = VUSResolutionPipeline().run(_base_case())
    assert isinstance(result, PipelineResult)
    assert result.trail                                # the trail is populated
    assert isinstance(result.classification, Classification)


def test_pipeline_ba1_short_circuits_to_benign():
    case = _base_case(frequency=FrequencyEvidence(popmax_af=0.12, allele_number=1_400_000))
    result = VUSResolutionPipeline().run(case)
    assert result.classification is Classification.BENIGN
    assert result.points_display == "Stand-alone (BA1)"


def test_pipeline_gene_validity_caps_at_vus():
    case = _base_case(gene_validity=GeneValidity.REFUTED)
    result = VUSResolutionPipeline().run(case)
    assert result.classification is Classification.VUS
    assert "gene validity" in result.terminal


def test_pipeline_upgrades_with_pvs1_plus_pm3():
    case = _base_case(
        molecular_class=MolecularClass.TRUNCATING,
        nmd_competent=True,
        established_lof_mechanism=True,
        insilico=InSilicoEvidence(),
        zygosity=Zygosity.COMP_HET_AR,
        phase_result="trans",
        trans_allele_is_pathogenic=True,
    )
    result = VUSResolutionPipeline().run(case)
    codes = {e.code for e in result.evidence}
    assert {"PVS1", "PM3", "PM2"} <= codes
    # PVS1 8 + PM3 2 + PM2 1 = 11
    assert result.total_points == 11
    assert result.classification is Classification.PATHOGENIC


def test_pipeline_flags_conflicting_strong_evidence():
    case = _base_case(
        insilico=InSilicoEvidence(revel=0.99),          # PP3 Strong
        zygosity=Zygosity.HET_DOMINANT,
        segregates_with_disease=False,                  # BS4 Strong
    )
    result = VUSResolutionPipeline().run(case)
    assert result.classification is Classification.VUS
    assert "Conflicting" in result.terminal


def test_pipeline_reanalysis_parks_vus():
    case = _base_case(
        insilico=InSilicoEvidence(revel=0.45),          # indeterminate
        zygosity=Zygosity.COMP_HET_AR,
        parents_available=False,
        reads_shared_for_phasing=False,
    )
    result = VUSResolutionPipeline().run(case)
    assert result.classification is Classification.VUS


def test_pipeline_report_renders():
    text = VUSResolutionPipeline().run(_base_case()).report()
    assert "Final classification:" in text
    assert "Decision trail:" in text


# ---------------------------------------------------------------------

def _run_all() -> int:
    import traceback
    fns = [(n, f) for n, f in sorted(globals().items())
           if n.startswith("test_") and callable(f)]
    failures = 0
    for name, fn in fns:
        try:
            fn()
            print(f"  PASS  {name}")
        except Exception:                               # noqa: BLE001
            failures += 1
            print(f"  FAIL  {name}")
            traceback.print_exc()
    print(f"\n{len(fns) - failures}/{len(fns)} passed")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(_run_all())
