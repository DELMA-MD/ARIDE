def classify_from_points(total: int) -> str:
    """Maps a total Tavtigian point score onto an ACMG/AMP classification
    label, using the same thresholds as the pipeline's Step 7 recombine
    (>=10 Pathogenic, 6-9 Likely Pathogenic, 0-5 VUS, <=-1 Likely Benign/
    Benign)."""
    if total >= 10:
        return "Pathogenic"
    if 6 <= total <= 9:
        return "Likely Pathogenic"
    if total <= -1:
        return "Likely Benign / Benign"
    return "Uncertain Significance"


def pipeline_evidence_table(result: "PipelineResult"):
    """Turns a PipelineResult's evidence list into table rows of
    Criterion / Description / Strength / Points, plus a display-ready
    total (handling the BA1 stand-alone short-circuit the same way
    PipelineResult.report() does)."""
    rows = []
    for e in result.evidence:
        points_display = "Stand-alone" if e.strength == Strength.STAND_ALONE else f"{e.points:+d}"
        rows.append(
            {
                "Criterion": e.code,
                "Description": ACMG_CRITERIA_DESCRIPTIONS.get(e.code, "\u2014"),
                "Strength": e.strength.name,
                "Points": points_display,
            }
        )
    has_standalone = any(e.strength == Strength.STAND_ALONE for e in result.evidence)
    total_display = "Stand-alone" if has_standalone else f"{result.total_points:+d}"
    return rows, total_display


# =====================================================================
# STEP 5 (REPLACED) — dbNSFP annotation, via MyVariant.info
#
# The dbNSFP project's own public browser (https://query.dbnsfp.org) has
# no documented/public REST API — it's a single-page app, its backend
# route disallows automated fetching (robots.txt), and it isn't on this
# environment's outbound network allowlist either. MyVariant.info is
# used instead: it's a stable, documented, free, no-auth REST API that
# aggregates and re-publishes the SAME dbNSFP release (functional
# predictors, conservation scores, gnomAD-derived frequencies) alongside
# dbSNP and ClinVar for the same variant, indexed on both hg19 and hg38.
# Reference: https://docs.myvariant.info/
#
# IMPORTANT — this integration could not be exercised against a live
# response in this environment (myvariant.info is also outside the
# sandbox's outbound allowlist), so field paths below are taken from
# MyVariant.info's published schema/docs rather than a verified live
# call. The raw JSON is always shown in an expander in the UI below so
# you can check/adjust field names quickly against what actually comes
# back the first time you run this.
#
# Like the previous annotation source, this only ever receives a bare
# chr-pos-ref-alt, so it can supply exactly the Step-1/Step-2/Step-3
# evidence (population frequency, REVEL, AlphaMissense, CADD, splice
# predictors) — never zygosity, phasing, family or functional-assay
# data, which are collected from the user separately.
# =====================================================================

MYVARIANT_URL_TMPL = "https://myvariant.info/v1/variant/{hgvs}"
MYVARIANT_FIELDS = (
    "dbnsfp,dbsnp,clinvar,gnomad_exome,gnomad_genome,exac,"
    "cadd,dbscsnv,vcf"
)

DBNSFP_TRUNCATING_EFFECTS = {
    "stop_gained", "stop gained", "frameshift_variant", "frameshift variant",
    "splice_donor_variant", "splice donor variant",
    "splice_acceptor_variant", "splice acceptor variant", "start_lost", "start lost",
}
DBNSFP_INFRAME_EFFECTS = {
    "inframe_deletion", "inframe deletion", "inframe_insertion", "inframe insertion",
    "stop_lost", "stop lost",
}
DBNSFP_MISSENSE_EFFECTS = {"missense_variant", "missense variant", "nonsynonymous snv"}


def build_genomic_hgvs(chrom: str, pos: str, ref: str, alt: str) -> str:
    """chr3, 97784972, T, C -> 'chr3:g.97784972T>C' (MyVariant.info's
    HGVS-genomic variant id format)."""
    c = chrom.strip().replace("chr", "")
    return f"chr{c}:g.{pos.strip()}{ref.strip().upper()}>{alt.strip().upper()}"


def _first_present(d: dict, *paths, default=None):
    """Walks a list of dotted paths (e.g. 'dbnsfp.gnomad4.af_total') against
    nested dict d and returns the first non-None value found. Defensive
    helper since exact field names/nesting can shift between dbNSFP/
    MyVariant.info releases — see module docstring above."""
    for path in paths:
        node = d
        ok = True
        for key in path.split("."):
            if isinstance(node, list):
                node = node[0] if node else None
            if isinstance(node, dict) and key in node:
                node = node[key]
            else:
                ok = False
                break
        if ok and node is not None:
            return node
    return default


def _flatten_values(val):
    """dbNSFP predictor scores/predictions are reported per-transcript,
    so MyVariant.info often returns a list (sometimes nested) instead of
    a single value when a variant maps to multiple transcripts. Flattens
    that into a clean list, dropping Nones."""
    if val is None:
        return []
    if not isinstance(val, list):
        return [val]
    flat = []
    for v in val:
        flat.extend(_flatten_values(v))
    return flat


def _worst_case_score(val, higher_is_more_damaging: bool = True) -> Optional[float]:
    """Reduces a scalar-or-list dbNSFP score to one float, taking the
    worst-case (most damaging) value across transcripts when there are
    several \u2014 the standard convention for these predictors. Pass
    higher_is_more_damaging=False for SIFT, which is inverted (lower
    score = more damaging)."""
    nums = []
    for v in _flatten_values(val):
        try:
            nums.append(float(v))
        except (TypeError, ValueError):
            continue
    if not nums:
        return None
    return max(nums) if higher_is_more_damaging else min(nums)


def _worst_case_pred(val, severity_rank: list) -> Optional[str]:
    """Reduces a scalar-or-list dbNSFP prediction letter code to a
    single code, preferring whichever entry in severity_rank (ordered
    most- to least-damaging) is present across transcripts."""
    codes = {str(v) for v in _flatten_values(val)}
    if not codes:
        return None
    for code in severity_rank:
        if code in codes:
            return code
    return next(iter(codes))


POLYPHEN2_LABELS = {"D": "Probably damaging", "P": "Possibly damaging", "B": "Benign"}
POLYPHEN2_RANK = ["D", "P", "B"]

SIFT_LABELS = {"D": "Deleterious", "T": "Tolerated"}
SIFT_RANK = ["D", "T"]

MUTATIONTASTER_LABELS = {
    "A": "Disease causing (high-confidence)",
    "D": "Disease causing",
    "N": "Polymorphism (benign)",
    "P": "Polymorphism (high-confidence benign)",
}
MUTATIONTASTER_RANK = ["A", "D", "N", "P"]


def _fmt_score(value, decimals: int = 3) -> str:
    """Formats a plain numeric score, or '-' if it's missing."""
    return f"{value:.{decimals}f}" if isinstance(value, (int, float)) else "-"


def _fmt_af(value) -> str:
    """Formats an allele frequency in scientific notation, or '-' if
    it's missing."""
    return f"{value:.2e}" if isinstance(value, (int, float)) else "-"


def _fmt_text(value) -> str:
    """Formats a plain text/identifier field, or '-' if it's missing."""
    return str(value) if value else "-"


def _fmt_predictor_grid_entry(score, code, label, decimals: int = 3):
    """Builds the (value, caption) pair for a predictor that carries
    both a numeric score and a code/label pair, following this order
    of preference:
      1. Score available          -> score is the value; 'CODE \u2014 Label'
                                      is the caption underneath.
      2. Score missing, code/label
         available                -> 'CODE \u2014 Label' becomes the value
                                      itself (no separate caption).
      3. Neither available        -> value is '-'.
    """
    if code and label and code != label:
        code_label = f"{code} \u2014 {label}"
    else:
        code_label = label or code

    if isinstance(score, (int, float)):
        return f"{score:.{decimals}f}", code_label
    if code_label:
        return code_label, None
    return "-", None


def query_dbnsfp(chrom: str, pos: str, ref: str, alt: str, genome: str = "hg38", timeout: int = 20):
    """Single-variant lookup against MyVariant.info (mirrors dbNSFP +
    dbSNP + ClinVar + gnomAD for the same variant). Returns the
    annotation dict, or a dict with an 'error' key on failure / no hit."""
    hgvs = build_genomic_hgvs(chrom, pos, ref, alt)
    params = {"fields": MYVARIANT_FIELDS}
    if genome == "hg38":
        params["assembly"] = "hg38"
    url = MYVARIANT_URL_TMPL.format(hgvs=hgvs)
    try:
        r = requests.get(url, params=params, headers={"Accept": "application/json"}, timeout=timeout)
    except Exception as e:
        return {"error": str(e), "hgvs": hgvs}

    if r.status_code == 404:
        return {"error": f"No dbNSFP/MyVariant.info record found for {hgvs}.", "hgvs": hgvs}
    try:
        r.raise_for_status()
        data = r.json()
    except Exception as e:
        return {"error": f"{e} (HTTP {r.status_code})", "hgvs": hgvs}

    if isinstance(data, dict) and data.get("success") is False:
        return {"error": data.get("error", "MyVariant.info returned no annotation."), "hgvs": hgvs}

    data["_hgvs"] = hgvs
    return data


def dbnsfp_popmax_af(annotation: dict) -> float:
    """Best-effort popmax allele frequency: prefers an explicit dbNSFP
    popmax field, falls back to the max across gnomAD exome/genome
    population subsets MyVariant.info exposes."""
    explicit = _first_present(
        annotation,
        "dbnsfp.gnomad4.1_joint.af_popmax",
        "dbnsfp.gnomad.af_popmax",
        "dbnsfp.gnomad4.af_popmax_joint",
    )
    if explicit is not None:
        try:
            return float(explicit)
        except (TypeError, ValueError):
            pass

    candidates = []
    for src in ("gnomad_exome", "gnomad_genome"):
        block = annotation.get(src) or {}
        af_block = block.get("af") or {}
        if isinstance(af_block, dict):
            for key, val in af_block.items():
                if key.startswith("af_") and isinstance(val, (int, float)):
                    candidates.append(val)
            if isinstance(af_block.get("af"), (int, float)):
                candidates.append(af_block["af"])
    return max(candidates) if candidates else 0.0


def dbnsfp_homozygotes_observed(annotation: dict) -> bool:
    total = 0
    for src in ("gnomad_exome", "gnomad_genome"):
        block = annotation.get(src) or {}
        hom_block = block.get("hom") or {}
        if isinstance(hom_block, dict):
            for val in hom_block.values():
                if isinstance(val, (int, float)):
                    total += val
        elif isinstance(hom_block, (int, float)):
            total += hom_block
    return total > 0


def dbnsfp_molecular_class(annotation: dict) -> MolecularClass:
    effect = str(_first_present(
        annotation,
        "dbnsfp.ensembl.consequence",
        "dbnsfp.vep.consequence",
        "dbnsfp.genename",  # placeholder path kept out of the OR chain below
        default="",
    ) or "").lower()
    # genename above is never an effect string; re-derive cleanly:
    effect = str(_first_present(
        annotation,
        "dbnsfp.ensembl.consequence",
        "dbnsfp.vep.consequence",
        default="",
    ) or "").lower()

    if effect in DBNSFP_TRUNCATING_EFFECTS:
        return MolecularClass.TRUNCATING
    if effect in DBNSFP_INFRAME_EFFECTS:
        return MolecularClass.INFRAME_INDEL
    if effect in DBNSFP_MISSENSE_EFFECTS:
        return MolecularClass.MISSENSE
    return MolecularClass.SPLICE_OR_SYNONYMOUS


def dbnsfp_revel_score(annotation: dict) -> Optional[float]:
    val = _first_present(annotation, "dbnsfp.revel.score", "dbnsfp.revel_score")
    return _worst_case_score(val)


def dbnsfp_alphamissense_score(annotation: dict) -> Optional[float]:
    val = _first_present(annotation, "dbnsfp.alphamissense.score", "dbnsfp.alphamissense_score")
    return _worst_case_score(val)


def dbnsfp_cadd_phred(annotation: dict) -> Optional[float]:
    val = _first_present(annotation, "cadd.phred", "dbnsfp.cadd.phred", "dbnsfp.cadd_phred")
    return _worst_case_score(val)


def dbnsfp_1000g_af(annotation: dict) -> Optional[float]:
    """1000 Genomes Project Phase 3 global allele frequency (via dbNSFP).
    Field name starts with a digit in dbNSFP's own schema ('1000Gp3'),
    so MyVariant.info exposes it as the string key '1000gp3'."""
    val = _first_present(
        annotation,
        "dbnsfp.1000gp3.af",
        "dbnsfp.1000gp3.gaf",
        "dbnsfp.1000gp3_af",
    )
    return _worst_case_score(val)


def dbnsfp_exac_af(annotation: dict) -> Optional[float]:
    """ExAC allele frequency \u2014 prefers MyVariant.info's dedicated
    'exac' data source block (same af.af shape as gnomad_exome/
    gnomad_genome), falls back to the copy dbNSFP itself carries.
    Note: ExAC is superseded by gnomAD (which absorbed the ExAC
    samples) \u2014 shown here for reference/cross-checking only, not
    used in BA1/BS1/PM2 below."""
    af_block = (annotation.get("exac") or {}).get("af") or {}
    if isinstance(af_block, dict) and isinstance(af_block.get("af"), (int, float)):
        return float(af_block["af"])
    val = _first_present(annotation, "dbnsfp.exac.af", "dbnsfp.exac_af")
    return _worst_case_score(val)


def dbnsfp_polyphen2_score(annotation: dict):
    """Returns (score, code, label). Prefers PolyPhen2 HDIV (the variant
    ACMG/AMP guidance historically referenced), falls back to HVAR.
    Multiple transcripts are reduced to the single worst-case (most
    damaging) score and prediction."""
    score = _first_present(
        annotation,
        "dbnsfp.polyphen2.hdiv.score", "dbnsfp.polyphen2_hdiv_score",
        "dbnsfp.polyphen2.hvar.score", "dbnsfp.polyphen2_hvar_score",
    )
    pred = _first_present(
        annotation,
        "dbnsfp.polyphen2.hdiv.pred", "dbnsfp.polyphen2_hdiv_pred",
        "dbnsfp.polyphen2.hvar.pred", "dbnsfp.polyphen2_hvar_pred",
    )
    code = _worst_case_pred(pred, POLYPHEN2_RANK)
    label = POLYPHEN2_LABELS.get(code, code) if code else None
    return _worst_case_score(score), code, label


def dbnsfp_sift_score(annotation: dict):
    """Returns (score, code, label). Unlike most predictors here, SIFT
    is inverted \u2014 LOWER means more damaging (conventionally <=0.05
    is 'deleterious'), so the worst-case score is the MINIMUM across
    transcripts, not the maximum."""
    score = _first_present(annotation, "dbnsfp.sift.score", "dbnsfp.sift_score")
    pred = _first_present(annotation, "dbnsfp.sift.pred", "dbnsfp.sift_pred")
    code = _worst_case_pred(pred, SIFT_RANK)
    label = SIFT_LABELS.get(code, code) if code else None
    return _worst_case_score(score, higher_is_more_damaging=False), code, label


def dbnsfp_mutationtaster_score(annotation: dict):
    """Returns (score, code, label). MutationTaster's own prediction
    codes (A/D/N/P) aren't self-explanatory on their own, so the label
    spells them out \u2014 e.g. code 'N', label 'Polymorphism (benign)'."""
    score = _first_present(annotation, "dbnsfp.mutationtaster.score", "dbnsfp.mutationtaster_score")
    pred = _first_present(annotation, "dbnsfp.mutationtaster.pred", "dbnsfp.mutationtaster_pred")
    code = _worst_case_pred(pred, MUTATIONTASTER_RANK)
    label = MUTATIONTASTER_LABELS.get(code, code) if code else None
    return _worst_case_score(score), code, label


def dbnsfp_splice_score(annotation: dict) -> Optional[float]:
    """dbNSFP itself doesn't carry SpliceAI (it's an nsSNV/ssSNV
    predictor database, not a splicing-specific one); dbscSNV's ADA/RF
    ensemble scores are the closest 0-1 splice-impact proxy it ships,
    used here as a stand-in for the pipeline's SpliceAI-delta slot."""
    ada = _first_present(annotation, "dbscsnv.ada_score", "dbnsfp.dbscsnv.ada_score")
    rf = _first_present(annotation, "dbscsnv.rf_score", "dbnsfp.dbscsnv.rf_score")
    vals = [v for v in (ada, rf) if isinstance(v, (int, float))]
    return max(vals) if vals else None


def dbnsfp_rsid(annotation: dict) -> Optional[str]:
    return _first_present(annotation, "dbsnp.rsid")


def dbnsfp_clinvar_ids(annotation: dict):
    """Returns (variant_id, list_of_rcv_accessions) — MyVariant.info's
    ClinVar block. variant_id is what NCBI's /clinvar/variation/<id>/
    permalink expects."""
    clinvar = annotation.get("clinvar") or {}
    variant_id = clinvar.get("variant_id")
    rcv = clinvar.get("rcv")
    if isinstance(rcv, dict):
        rcv = [rcv]
    accessions = [r.get("accession") for r in (rcv or []) if isinstance(r, dict) and r.get("accession")]
    return variant_id, accessions


def dbnsfp_to_case_kwargs(annotation: dict) -> dict:
    gene = _first_present(annotation, "dbnsfp.genename", "dbnsfp.hgnc_id", default="")
    if isinstance(gene, list):
        gene = gene[0] if gene else ""
    return {
        "gene": gene,
        "molecular_class": dbnsfp_molecular_class(annotation),
        "gnomad_popmax_faf": dbnsfp_popmax_af(annotation),
        "healthy_homozygotes_observed": dbnsfp_homozygotes_observed(annotation),
        "revel_score": dbnsfp_revel_score(annotation),
        "spliceai_delta": dbnsfp_splice_score(annotation),
    }


def dbnsfp_acmg_table_rows(annotation: dict, case_kwargs: dict):
    rows = []
    popmax = case_kwargs["gnomad_popmax_faf"]

    if popmax > 0.05:
        rows.append(("BA1", "Stand-alone", -8))
    elif popmax > 0.0001:
        rows.append(("BS1", "Strong", -4))

    if case_kwargs["healthy_homozygotes_observed"]:
        rows.append(("BS2", "Strong", -4))

    if popmax == 0.0:
        rows.append(("PM2", "Moderate", 2))

    revel = case_kwargs["revel_score"]
    if revel is not None:
        if revel >= 0.932:
            rows.append(("PP3", "Strong", 4))
        elif revel >= 0.773:
            rows.append(("PP3", "Moderate", 2))
        elif revel >= 0.644:
            rows.append(("PP3", "Supporting", 1))
        elif revel <= 0.016:
            rows.append(("BP4", "Strong", -4))
        elif revel <= 0.183:
            rows.append(("BP4", "Moderate", -2))
        elif revel <= 0.290:
            rows.append(("BP4", "Supporting", -1))

    table = []
    for code, strength_label, points in rows:
        desc = ACMG_CRITERIA_DESCRIPTIONS.get(code, "\u2014")
        basis = ACMG_CRITERIA_BASIS.get(code)
        if basis:
            desc = f"{desc} \u2014 based on {basis}"
        table.append({
            "Criterion": code,
            "Description": desc,
            "Strength": strength_label,
            "Points": "Stand-alone" if strength_label == "Stand-alone" else f"{points:+d}",
        })
    return table


