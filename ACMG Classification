from __future__ import annotations
import re
import time
import requests
import streamlit as st
from dataclasses import dataclass, field
from enum import Enum
from typing import Optional

ESEARCH_URL = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"
ESUMMARY_URL = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi"

CLASS_COLORS = {
    "pathogenic": "#b23b3b",
    "likely pathogenic": "#c9645a",
    "pathogenic/likely pathogenic": "#b23b3b",
    "uncertain significance": "#c98a1a",
    "vus": "#c98a1a",
    "benign": "#2a7f4f",
    "likely benign": "#4f9f6f",
    "benign/likely benign": "#2a7f4f",
    "conflicting classifications of pathogenicity": "#8a5fb2",
}

def extract_c_notation(title: str) -> str:
    match = re.search(r":(c\.[^\s(]+)", title)
    return match.group(1).strip() if match else ""

def query_clinvar(gene: str, variant: str, retries: int = 3):
    term = f'{gene}[gene] AND "{variant}"[Variant name]'
    params = {"db": "clinvar", "term": term, "retmode": "json", "retmax": 20}

    ids = []
    last_err = None
    for attempt in range(retries):
        try:
            r = requests.get(ESEARCH_URL, params=params, timeout=15)
            r.raise_for_status()
            ids = r.json().get("esearchresult", {}).get("idlist", [])
            last_err = None
            break
        except Exception as e:
            last_err = e
            time.sleep(1)
    if last_err is not None:
        raise last_err

    if not ids:
        params["term"] = f"{gene}[gene] AND {variant}"
        r = requests.get(ESEARCH_URL, params=params, timeout=15)
        r.raise_for_status()
        ids = r.json().get("esearchresult", {}).get("idlist", [])

    if not ids:
        return []

    sum_params = {"db": "clinvar", "id": ",".join(ids), "retmode": "json"}
    r = requests.get(ESUMMARY_URL, params=sum_params, timeout=15)
    r.raise_for_status()
    result = r.json().get("result", {})

    variant_clean = variant.strip().lower()
    records = []
    for uid in ids:
        rec = result.get(uid)
        if not rec:
            continue
        title = rec.get("title", "")

        if extract_c_notation(title).lower() != variant_clean:
            continue

        germline = rec.get("germline_classification", {}) or {}
        last_evaluated_raw = germline.get("last_evaluated", "")
        last_evaluated_date = last_evaluated_raw.split(" ")[0] if last_evaluated_raw else ""
        records.append(
            {
                "accession": rec.get("accession", uid),
                "title": title,
                "classification": germline.get("description", "Not provided"),
                "last_evaluated": last_evaluated_date,
                "link": f"https://www.ncbi.nlm.nih.gov/clinvar/variation/{uid}/",
            }
        )
    return records

def badge(classification: str) -> str:
    color = CLASS_COLORS.get(classification.strip().lower(), "#5a6675")
    return (
        f'<span style="background:{color};color:white;padding:2px 10px;'
        f'border-radius:12px;font-size:0.85em;font-weight:600">{classification}</span>'
    )

def needs_reclassification(classification: str) -> bool:
    c = classification.strip().lower()
    is_settled = ("pathogenic" in c or "benign" in c) and "conflicting" not in c and "uncertain" not in c
    return not is_settled

st.set_page_config(page_title="VUS Reclassification", page_icon="\U0001F9EC", layout="centered")

if "view" not in st.session_state:
    st.session_state["view"] = "clinvar"

# ClinVar check
def render_clinvar_slide():
    st.title("ClinVar Verification")
    st.caption("Check the current ClinVar classification")

    with st.form("intake_form"):
        c1, c2 = st.columns(2)
        with c1:
            gene = st.text_input("Gene", placeholder="e.g. EYS")
        with c2:
            variant = st.text_input("HGVS variant (c. notation)", placeholder="e.g. c.9270_9271insA")
        submitted = st.form_submit_button("Check in ClinVar")

    if submitted:
        if not gene.strip() or not variant.strip():
            st.warning("Enter both gene symbol and variant.")
        else:
            with st.spinner(f"Verifying for {gene} {variant}... in ClinVar"):
                try:
                    results = query_clinvar(gene.strip(), variant.strip())
                    error = None
                except Exception as e:
                    results, error = None, e

            if error is not None:
                st.error(f"ClinVar lookup failed: {error}")
            elif not results:
                st.info(
                    f"No ClinVar record found for {gene} {variant}. "
                    "Proceed to Reclassification"
                )
                st.session_state["start"] = {"gene": gene, "variant": variant, "status": "not_found"}
                st.session_state.pop("reclass_variants", None)
            else:
                st.success(f"Found {len(results)} ClinVar record(s) for {gene} {variant}")
                for rec in results:
                    st.markdown(
                        f"**{rec['title']}**  \n"
                        f"{badge(rec['classification'])} &nbsp;\u00b7&nbsp; "
                        f"Last evaluated: {rec['last_evaluated'] or '\u2014'}  \n"
                        f"[View in ClinVar]({rec['link']}) &nbsp;\u00b7&nbsp; Accession: `{rec['accession']}`",
                        unsafe_allow_html=True,
                    )
                    st.divider()

                primary = results[0]["classification"].strip().lower()

                if needs_reclassification(primary):
                    if "conflicting" in primary:
                        st.warning("Conflicting classifications in ClinVar. Proceed to Reclassification.")
                    else:
                        st.warning("Uncertain significance. Proceed to Reclassification.")
                else:
                    label = "Pathogenic" if "pathogenic" in primary else "Benign"
                    st.success(
                        f"Already classified as {label} based on current ClinVar evidence \u2014 "
                        f"Reclassification is not needed."
                    )

                st.session_state["start"] = {
                    "gene": gene,
                    "variant": variant,
                    "status": primary,
                    "records": results,
                }
                st.session_state.pop("reclass_variants", None)

    if "start" in st.session_state:
        st.divider()
        status = st.session_state["start"]["status"]
        reclass_enabled = needs_reclassification(status)

        if st.button("Reclassification \u2192", disabled=not reclass_enabled, use_container_width=True):
            st.session_state["view"] = "reclass"
            st.rerun()

# Variant intake for reclassification
def render_reclass_slide():
    if st.button("\u2190 Back to ClinVar check"):
        st.session_state["view"] = "clinvar"
        st.rerun()

    st.title("Variant Intake")
    st.caption("Enter the variant details required for database/tool lookup")

    prior = st.session_state.get("start", {})

    with st.form("variant_form"):

        col1, col2 = st.columns(2)
        with col1:
            gene_symbol = st.text_input("Gene symbol", value=prior.get("gene", ""), placeholder="ARL6")
        with col2:
            transcript_id = st.text_input("Transcript ID", placeholder="NM_177976.3")

        col3, col4 = st.columns(2)
        with col3:
            chromosome = st.text_input("Chromosome", placeholder="3")
        with col4:
            position = st.text_input("Position (GRCh38)", placeholder="97784972")

        col5, col6 = st.columns(2)
        with col5:
            ref_allele = st.text_input("Reference allele", placeholder="T")
        with col6:
            alt_allele = st.text_input("Alternate allele", placeholder="C")

        col7, col8 = st.columns(2)
        with col7:
            hgvs_c = st.text_input("HGVS coding (c.)", value=prior.get("variant", ""), placeholder="c.272T>C")
        with col8:
            hgvs_p = st.text_input("HGVS protein (p.)", placeholder="p.Ile91Thr")

        variant_submitted = st.form_submit_button("Submit variant")

    if variant_submitted:
        required = {
            "Gene symbol": gene_symbol,
            "Transcript ID": transcript_id,
            "Chromosome": chromosome,
            "Position": position,
            "Reference allele": ref_allele,
            "Alternate allele": alt_allele,
            "HGVS coding (c.)": hgvs_c,
            "HGVS protein (p.)": hgvs_p
        }
        missing = [name for name, val in required.items() if not val.strip()]

        if missing:
            st.error(f"Missing required field(s): {', '.join(missing)}")
        else:
            variant_record = {
                "gene_symbol": gene_symbol.strip(),
                "transcript_id": transcript_id.strip(),
                "chromosome": chromosome.strip(),
                "position": position.strip(),
                "ref_allele": ref_allele.strip().upper(),
                "alt_allele": alt_allele.strip().upper(),
                "hgvs_c": hgvs_c.strip(),
                "hgvs_p": hgvs_p.strip(),
                "hgvs_genomic": f"chr{chromosome.strip()}:g.{position.strip()}{ref_allele.strip().upper()}>{alt_allele.strip().upper()}",
            }

            if "reclass_variants" not in st.session_state:
                st.session_state.reclass_variants = []
            st.session_state.reclass_variants.append(variant_record)
if st.session_state["view"] == "clinvar":
    render_clinvar_slide()
else:
    render_reclass_slide()

class Strength(Enum):
    VERY_STRONG = 8
    STRONG = 4
    MODERATE = 2
    SUPPORTING = 1
    STAND_ALONE = 8

BENIGN_CODES = {"BA1", "BS1", "BS2", "BS3", "BS4", "BP1", "BP2", "BP3", "BP4", "BP5", "BP6", "BP7"}

@dataclass
class EvidenceLine:
    code: str            
    strength: Strength
    step: str             
    note: str = ""

    @property
    def points(self) -> int:
        sign = -1 if self.code in BENIGN_CODES else 1
        return sign * self.strength.value


class MolecularClass(Enum):
    TRUNCATING = "truncating"                 # nonsense / frameshift / canonical +/-1,2 splice
    MISSENSE = "missense"
    INFRAME_INDEL = "inframe_indel"
    SPLICE_OR_SYNONYMOUS = "splice_or_synonymous"  # synonymous / deep-intronic / near-splice non-canonical


class Inheritance(Enum):
    AR = "autosomal_recessive"
    AD = "autosomal_dominant"
    XL = "x_linked"


class GeneValidity(Enum):
    DEFINITIVE = "definitive"
    STRONG = "strong"
    MODERATE = "moderate"
    LIMITED = "limited"
    DISPUTED = "disputed"
    REFUTED = "refuted"
    NO_KNOWN = "no_known_disease_relationship"


class Zygosity(Enum):
    HOM_AR = "homozygous_in_AR_gene"
    COMP_HET_AR = "two_het_same_AR_gene"
    SINGLE_HET_AR = "single_het_in_AR_gene"
    HET_DOMINANT = "het_in_dominant_gene"
    HEMI_XL_MALE = "hemizygous_x_linked_male"


@dataclass
class VariantCase:
    variant_id: str
    gene: str
    inheritance: Inheritance
    gene_validity: GeneValidity
    molecular_class: MolecularClass

    gnomad_popmax_faf: float = 0.0            # 0-1 fraction
    max_credible_af_for_disease: float = 0.0001
    healthy_homozygotes_observed: bool = False

    # Step 3a — LoF / NMD
    nmd_competent: Optional[bool] = None
    established_lof_mechanism: bool = True
    frame_preserving: bool = False

    # Step 3b/3c — in-silico
    revel_score: Optional[float] = None        # missense / in-frame indel
    spliceai_delta: Optional[float] = None      # near-splice/synonymous/deep-intronic

    # Step 4 — genotype
    zygosity: Optional[Zygosity] = None

    # Step 5a — ROH (consanguinity)
    in_roh: Optional[bool] = None
    roh_length_mb: float = 0.0

    # Step 5b — phasing
    parents_available: Optional[bool] = None
    reads_shared_for_phasing: bool = False
    phase_result: Optional[str] = None          # "trans" | "cis" | None

    # Step 5c — second-allele hunt
    cnv_found: Optional[bool] = None
    cnv_is_null: bool = False
    phenotype_strongly_matches_gene: bool = False
    wgs_deep_intronic_found: Optional[bool] = None
    complex_sv_locus: bool = False              # e.g. RPGR-ORF15 / repeat region
    long_read_resolved: Optional[bool] = None

    # Step 5d — segregation / de novo
    segregates_with_disease: Optional[bool] = None
    informative_meioses: int = 0
    apparent_de_novo: Optional[bool] = None
    de_novo_confirmed: Optional[bool] = None

    # Step 6 — functional
    functional_assay_available: bool = False
    functional_assay_result: Optional[str] = None   # "pathogenic" | "benign" | "indeterminate"

    # Step 8 — scheduled reanalysis
    months_since_last_run: int = 0


@dataclass
class PipelineResult:
    variant_id: str
    classification: str = "VUS"
    terminal: str = ""
    evidence: list[EvidenceLine] = field(default_factory=list)
    trail: list[str] = field(default_factory=list)
    next_action: str = ""

    @property
    def total_points(self) -> int:
        return sum(e.points for e in self.evidence)

    def add(self, code: str, strength: Strength, step: str, note: str = "") -> None:
        self.evidence.append(EvidenceLine(code, strength, step, note))

    def log(self, msg: str) -> None:
        self.trail.append(msg)

    def finish(self, classification: str, terminal: str, next_action: str = "") -> "PipelineResult":
        self.classification = classification
        self.terminal = terminal
        self.next_action = next_action
        return self

    def report(self) -> str:
        has_standalone = any(e.strength == Strength.STAND_ALONE for e in self.evidence)
        points_str = "stand-alone" if has_standalone else f"{self.total_points:+d}"
        lines = [
            f"Variant: {self.variant_id}",
            f"Final classification: {self.classification}  (points: {points_str})",
            f"Terminal: {self.terminal}",
        ]
        if self.evidence:
            lines.append("Evidence accumulated:")
            for e in self.evidence:
                lines.append(f"  - {e.code} ({e.strength.name}, {e.points:+d} pts) @ {e.step}"
                             + (f" \u2014 {e.note}" if e.note else ""))
        lines.append("Decision trail:")
        for i, step in enumerate(self.trail, 1):
            lines.append(f"  {i}. {step}")
        if self.next_action:
            lines.append(f"Next action: {self.next_action}")
        return "\n".join(lines)


class VUSResolutionPipeline:

    def run(self, case: VariantCase) -> PipelineResult:
        result = PipelineResult(variant_id=case.variant_id)
        result.log("START: VUS after baseline ACMG re-scoring -> Step 1 (re-annotate)")
        return self.step1_reannotate(case, result)

    # ---- STEP 1 — re-annotate (free, computational) ---------------------- #
    def step1_reannotate(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 1: pull gnomAD v4 popmax FAF, REVEL/AlphaMissense, SpliceAI, ClinGen gene validity")

        if case.gnomad_popmax_faf > max(case.max_credible_af_for_disease, 0.05):
            r.add("BA1", Strength.STAND_ALONE, "Step1", "popmax FAF exceeds max credible AF / 5%")
            r.log("popmax FAF too high -> BA1/BS1, downgrade toward Benign")
            return r.finish("Benign / Likely Benign", "Downgraded", "Remove from candidate list")

        if case.healthy_homozygotes_observed and case.inheritance == Inheritance.AR:
            r.add("BS2", Strength.STRONG, "Step1", "healthy homozygotes in population-matched reference")
            r.log("Healthy homozygotes observed for high-penetrance AR gene -> BS2, downgrade")
            return r.finish("Likely Benign", "Downgraded", "Remove from candidate list")

        if case.gene_validity in (GeneValidity.DISPUTED, GeneValidity.REFUTED, GeneValidity.NO_KNOWN):
            r.log(f"Gene-disease validity is {case.gene_validity.value} -> cap at VUS regardless of variant evidence")
            return r.finish("VUS", "Parked (gene validity)",
                             "Park pending ClinGen gene-disease re-curation")

        r.log("Still uncertain after re-annotation -> Step 2 (molecular-class triage)")
        return self.step2_class_triage(case, r)

    # ---- STEP 2 — triage by molecular class ------------------------------ #
    def step2_class_triage(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log(f"STEP 2: molecular class = {case.molecular_class.value}")
        if case.molecular_class == MolecularClass.TRUNCATING:
            return self.step3a_lof(case, r)
        if case.molecular_class == MolecularClass.MISSENSE:
            return self.step3b_missense(case, r)
        if case.molecular_class == MolecularClass.INFRAME_INDEL:
            r.add("PM4", Strength.MODERATE, "Step2", "in-frame indel")
            r.log("In-frame indel -> PM4, also evaluate as missense (REVEL) if available")
            return self.step3b_missense(case, r)
        # synonymous / deep-intronic / near-splice
        return self.step3c_splice(case, r)

    # ---- STEP 3a — LoF: PVS1 via NMD decision -------------------------- #
    def step3a_lof(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 3a: grade PVS1 via NMD decision tree (Abou-Tayoun 2018)")
        if case.nmd_competent and case.established_lof_mechanism and not case.frame_preserving:
            r.add("PVS1", Strength.VERY_STRONG, "Step3a", "NMD-competent exon, established LoF mechanism")
            r.log("NMD-competent, established LoF -> PVS1 Very Strong (usually LP alone)")
        else:
            strength = Strength.MODERATE if case.frame_preserving else Strength.STRONG
            r.add("PVS1", strength, "Step3a", "NMD-escape (last exon/penultimate last-50bp) or frame-preserving")
            r.log(f"NMD-escape or frame-preserving -> PVS1 downgraded to {strength.name}; needs 2nd line")
        return self.step4_genotype(case, r)

    # ---- STEP 3b — missense / in-frame: calibrated in-silico ------------ #
    def step3b_missense(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 3b: calibrated REVEL/AlphaMissense (Pejaver 2022) — one line, capped strength")
        revel = case.revel_score
        if revel is None:
            r.log("No REVEL score available -> no in-silico code; rely on genotype/functional")
        elif revel >= 0.932:
            r.add("PP3", Strength.STRONG, "Step3b", f"REVEL={revel:.3f} >= 0.932")
        elif revel >= 0.773:
            r.add("PP3", Strength.MODERATE, "Step3b", f"REVEL={revel:.3f} in [0.773, 0.932)")
        elif revel >= 0.644:
            r.add("PP3", Strength.SUPPORTING, "Step3b", f"REVEL={revel:.3f} in [0.644, 0.773)")
        elif revel <= 0.016:
            r.add("BP4", Strength.STRONG, "Step3b", f"REVEL={revel:.3f} <= 0.016")
        elif revel <= 0.183:
            r.add("BP4", Strength.MODERATE, "Step3b", f"REVEL={revel:.3f} in (0.183, 0.290]")
        elif revel <= 0.290:
            r.add("BP4", Strength.SUPPORTING, "Step3b", f"REVEL={revel:.3f} in (0.183, 0.290]")
        else:
            r.log(f"REVEL={revel:.3f} in indeterminate band (0.290-0.644) -> no in-silico code")
        return self.step4_genotype(case, r)

    # ---- STEP 3c — near-splice/synonymous/deep-intronic: SpliceAI ------- #
    def step3c_splice(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 3c: SpliceAI prediction (Jaganathan 2019) — prediction only, not evidence")
        delta = case.spliceai_delta
        if delta is not None and delta >= 0.5:
            r.add("PP3", Strength.SUPPORTING, "Step3c", f"SpliceAI delta={delta:.2f} >= 0.5")
            r.log("SpliceAI \u0394>=0.5 -> PP3 supporting now; trigger RNA/minigene assay -> Step 6 functional")
            return self.step6_functional(case, r)
        if delta is not None and delta < 0.2:
            r.add("BP4", Strength.SUPPORTING, "Step3c", f"SpliceAI delta={delta:.2f} < 0.2")
            r.log("SpliceAI \u0394<0.2 -> BP4/BP7 supporting benign")
        else:
            r.log("SpliceAI in indeterminate band (0.2-0.5) or unavailable")
        return self.step4_genotype(case, r)

    # ---- STEP 4 — triage by genotype / zygosity ------------------------- #
    def step4_genotype(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log(f"STEP 4: genotype triage \u2014 zygosity = {case.zygosity.value if case.zygosity else 'unspecified'}")
        z = case.zygosity
        if z == Zygosity.HOM_AR:
            return self.step5a_roh(case, r)
        if z == Zygosity.COMP_HET_AR:
            return self.step5b_phase(case, r)
        if z == Zygosity.SINGLE_HET_AR:
            return self.step5c_second_allele(case, r)
        if z in (Zygosity.HET_DOMINANT, Zygosity.HEMI_XL_MALE):
            return self.step5d_segregation(case, r)
        r.log("Zygosity unspecified -> cannot route further; parking")
        return r.finish("VUS", "Parked (genotype unresolved)", "Confirm zygosity / genotype and re-run Step 4")

    # ---- STEP 5a — ROH / autozygosity mapping --------------------------- #
    def step5a_roh(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5a: ROH / autozygosity mapping (AutoMap; Quinodoz 2021)")
        if case.in_roh and case.roh_length_mb >= 1.5:
            r.log(f"Homozygous VUS in ROH ({case.roh_length_mb:.2f} Mb >= 1.5 Mb) -> locus prioritised")
            r.log("Frames PP1/BS4 -> proceed to segregation + functional")
            return self.step5d_segregation(case, r)
        r.log("VUS NOT in ROH (unexpected for consanguineous case) -> flag possible CNV masking het; "
              "reconsider as second-allele hunt")
        return self.step5c_second_allele(case, r)

    # ---- STEP 5b — phasing (compound-het trans confirmation) ------------ #
    def step5b_phase(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5b: phasing (PM3 requires trans configuration)")
        if case.phase_result == "cis":
            r.add("BP2", Strength.SUPPORTING, "Step5b", "variants confirmed in cis")
            r.log("Variants in cis -> reject biallelic hypothesis, apply BP2; look elsewhere")
            return self.step5c_second_allele(case, r)

        if case.parents_available:
            r.log("Parents available -> trio-phase")
        elif case.reads_shared_for_phasing:
            r.log("Parents unavailable, variants share reads -> read-backed phasing (WhatsHap)")
        else:
            r.log("Cannot phase (no parents, no shared reads) -> park pending phasing data")
            return r.finish("VUS", "Parked (unphased compound-het)",
                             "Obtain parental samples or long-read/read-backed phasing")

        if case.phase_result == "trans":
            r.add("PM3", Strength.MODERATE, "Step5b", "confirmed trans configuration")
            r.log("Confirmed trans -> PM3 (supporting->strong by points)")
            return self.step6_functional(case, r)

        r.log("Phase result not yet confirmed -> park pending phasing outcome")
        return r.finish("VUS", "Parked (phasing pending)", "Complete trio or read-backed phasing")

    # ---- STEP 5c — second-allele hunt ------------------------------------ #
    def step5c_second_allele(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5c: second-allele hunt (single het in AR gene \u2014 escalate cheapest-first)")

        if case.cnv_found:
            code, strength = ("PVS1", Strength.VERY_STRONG) if case.cnv_is_null else ("PM3", Strength.MODERATE)
            r.add(code, strength, "Step5c", "exon-level CNV found via read-depth (ExomeDepth), orthogonally confirmed")
            r.log("Exon-level deletion found -> 2nd allele identified; proceed to confirm trans")
            return self.step5b_phase(case, r)

        if case.wgs_deep_intronic_found:
            r.add("PP3", Strength.SUPPORTING, "Step5c", "WGS deep-intronic/structural allele found")
            r.log("CNV-negative + strong phenotype match -> WGS found deep-intronic/structural allele "
                  "-> trigger functional confirmation (RNA)")
            return self.step6_functional(case, r)

        if case.complex_sv_locus:
            if case.long_read_resolved:
                r.add("PM3", Strength.MODERATE, "Step5c", "breakpoints and phase resolved by long-read sequencing")
                r.log("RPGR-ORF15/repeat/complex SV resolved by long-read sequencing -> phase established")
                return self.step6_functional(case, r)
            r.log("Complex SV locus (e.g. RPGR-ORF15) not yet resolved -> long-read sequencing pending")
            return r.finish("VUS", "Parked (complex SV pending long-read)",
                             "Order long-read sequencing / dedicated SV resolution")

        if case.phenotype_strongly_matches_gene and case.wgs_deep_intronic_found is None:
            r.log("CNV-negative, strong phenotype match, WGS not yet done -> escalate to WGS")
            return r.finish("VUS", "Parked (awaiting WGS)",
                             "WGS for deep-intronic/structural alleles (e.g. ABCA4/USH2A)")

        r.log("All second-allele avenues negative -> park for scheduled reanalysis")
        return self.step8_scheduled_reanalysis(case, r, from_step="Step5c")

    # ---- STEP 5d — segregation & de novo ---------------------------------- #
    def step5d_segregation(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5d: segregation & de novo analysis")

        if case.apparent_de_novo:
            if case.de_novo_confirmed:
                r.add("PS2", Strength.STRONG, "Step5d", "de novo confirmed by parentage testing")
                r.log("Apparently de novo, parentage confirmed -> PS2")
            else:
                r.add("PM6", Strength.MODERATE, "Step5d", "de novo unconfirmed")
                r.log("Apparently de novo, parentage unconfirmed -> PM6")
            return self.step6_functional(case, r)

        if case.segregates_with_disease is True:
            strength = Strength.STRONG if case.informative_meioses >= 4 else Strength.SUPPORTING
            r.add("PP1", strength, "Step5d", f"tracks across {case.informative_meioses} informative meioses")
            r.log(f"Tracks with disease ({case.informative_meioses} meioses) -> PP1 {strength.name}")
            return self.step6_functional(case, r)

        if case.segregates_with_disease is False:
            r.add("BS4", Strength.STRONG, "Step5d", "present in unaffected relative / fails to track")
            r.log("Fails to track / present in unaffected -> BS4, downgrade")
            return r.finish("Likely Benign", "Downgraded", "Remove from candidate list")

        r.log("No segregation/de novo data yet -> proceed to functional evidence with existing evidence")
        return self.step6_functional(case, r)

    # ---- STEP 6 — functional / RNA evidence -------------------------------- #
    def step6_functional(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 6: functional/RNA evidence (converts prediction -> PS3-level evidence)")

        splice_like = case.molecular_class == MolecularClass.SPLICE_OR_SYNONYMOUS
        if splice_like and case.functional_assay_available:
            if case.functional_assay_result == "pathogenic":
                r.add("PS3", Strength.STRONG, "Step6", "minigene/RNA-seq confirms aberrant splicing")
                r.log("RNA assay confirms aberrant transcript -> PS3 Strong")
            elif case.functional_assay_result == "benign":
                r.add("BS3", Strength.STRONG, "Step6", "minigene/RNA-seq shows normal splicing")
                r.log("RNA assay shows normal splicing -> BS3 Strong")
            else:
                r.log("RNA assay indeterminate -> no PS3/BS3 code assigned")
        elif case.molecular_class in (MolecularClass.MISSENSE, MolecularClass.INFRAME_INDEL) \
                and case.functional_assay_available:
            if case.functional_assay_result == "pathogenic":
                r.add("PS3", Strength.STRONG, "Step6", "validated gene-specific functional assay (OddsPath-scaled)")
                r.log("Validated functional assay -> PS3 (OddsPath-scaled)")
            elif case.functional_assay_result == "benign":
                r.add("BS3", Strength.STRONG, "Step6", "validated gene-specific functional assay (OddsPath-scaled)")
                r.log("Validated functional assay -> BS3 (OddsPath-scaled)")
            else:
                r.log("Functional assay indeterminate -> no PS3/BS3 code assigned")
        else:
            r.log("No assay available -> proceed to recombine with existing evidence")

        return self.step7_recombine(case, r)

    # ---- STEP 7 — recombine (Tavtigian points) and re-classify ------------ #
    def step7_recombine(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        total = r.total_points
        r.log(f"STEP 7: recombine Tavtigian points -> total = {total:+d} "
              "(Supporting=1 / Moderate=2 / Strong=4 / Very Strong=8)")

        if total >= 10:
            return r.finish("Pathogenic", "Solved / upgraded", "Report")
        if 6 <= total <= 9:
            return r.finish("Likely Pathogenic", "Solved / upgraded",
                             "Report (with genotype-completeness caveat)")
        if total <= -1:
            return r.finish("Likely Benign / Benign", "Downgraded", "Remove from candidate list")

        # 0-5 points, still VUS
        return self.step8_scheduled_reanalysis(case, r, from_step="Step7")

    # ---- STEP 8 — scheduled reanalysis (the loop) -------------------------- #
    def step8_scheduled_reanalysis(self, case: VariantCase, r: PipelineResult, from_step: str) -> PipelineResult:
        r.log(f"STEP 8: still VUS (0-5 pts) at {from_step} -> park for scheduled reanalysis "
              "(>=12-month re-run yields ~10-15% additional diagnoses/cycle)")
        if case.months_since_last_run >= 12:
            r.log(">=12 months elapsed -> re-run pipeline from Step 1")
            return self.step1_reannotate(case, r)
        return r.finish("VUS", "Parked (scheduled reanalysis)",
                         f"Re-run from Step 1 in {max(0, 12 - case.months_since_last_run)} month(s), "
                         "or sooner if ClinVar/gnomAD/ClinGen updates")


