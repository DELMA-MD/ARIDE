def render_compact_metric_grid(items, columns: int = 6):

    for start in range(0, len(items), columns):
        row_items = items[start:start + columns]
        cols = st.columns(columns)
        for col, item in zip(cols, row_items):
            label, value = item[0], item[1]
            caption = item[2] if len(item) > 2 else None
            with col:
                st.markdown(
                    f"<div style='font-size:0.72em;color:#5a6675;"
                    f"line-height:1.2;margin-bottom:2px'>{label}</div>"
                    f"<div style='font-size:1.05em;font-weight:600;"
                    f"line-height:1.25;word-break:break-word'>{value}</div>"
                    + (
                        f"<div style='font-size:0.68em;color:#8a97a8;"
                        f"margin-top:1px'>{caption}</div>"
                        if caption else ""
                    ),
                    unsafe_allow_html=True,
                )


def render_dbnsfp_case_section():
    if not st.session_state.get("reclass_variants"):
        return

    st.divider()
    variants = st.session_state["reclass_variants"]
    labels = [f"{v['gene_symbol']} {v['hgvs_c'] or v['hgvs_genomic']}" for v in variants]
    selected_idx = st.selectbox(
        "Variant", options=range(len(variants)), format_func=lambda i: labels[i], key="dbnsfp_variant_select"
    )
    target = variants[selected_idx]

    # Fetch automatically as soon as a variant is selected — re-fetches only
    # when the selected variant actually changes, not on every rerun.
    cache_key = f"{target['chromosome']}:{target['position']}:{target['ref_allele']}:{target['alt_allele']}"
    if st.session_state.get("dbnsfp_cache_key") != cache_key:
        with st.spinner("Fetching annotation scores..."):
            st.session_state["dbnsfp_result"] = query_dbnsfp(
                target["chromosome"], target["position"], target["ref_allele"], target["alt_allele"]
            )
        st.session_state["dbnsfp_cache_key"] = cache_key

    annotation = st.session_state.get("dbnsfp_result")
    if not annotation:
        return

    if annotation.get("error"):
        st.error(f"Annotation lookup failed: {annotation['error']}")
        st.caption(f"Queried as: `{annotation.get('hgvs', '?')}`")
        return

    case_kwargs = dbnsfp_to_case_kwargs(annotation)
    rsid = dbnsfp_rsid(annotation)
    clinvar_variant_id, clinvar_accessions = dbnsfp_clinvar_ids(annotation)

    # --- Identifiers + gnomAD + 1000G/ExAC, as one compact 6-column grid ---
    st.subheader("Population frequency")
    popmax = case_kwargs["gnomad_popmax_faf"]
    kg_af = dbnsfp_1000g_af(annotation)
    exac_af = dbnsfp_exac_af(annotation)

    render_compact_metric_grid([
        ("dbSNP rsID", _fmt_text(rsid)),
        ("ClinVar variation ID", _fmt_text(clinvar_variant_id)),
        ("gnomAD popmax AF", f"{popmax:.2e}" if popmax else "0 (absent)"),
        ("Homozygotes observed", "Yes" if case_kwargs["healthy_homozygotes_observed"] else "No"),
        ("1000 Genomes AF", _fmt_af(kg_af)),
        ("ExAC AF", _fmt_af(exac_af)),
    ], columns=6)


    # --- All available in-silico scores, same compact 6-column grid ---
    st.subheader("In-silico scores")
    revel_val = case_kwargs["revel_score"]
    alpha_val = dbnsfp_alphamissense_score(annotation)
    cadd_val = dbnsfp_cadd_phred(annotation)
    polyphen2_score, polyphen2_code, polyphen2_label = dbnsfp_polyphen2_score(annotation)
    sift_score, sift_code, sift_label = dbnsfp_sift_score(annotation)
    mt_score, mt_code, mt_label = dbnsfp_mutationtaster_score(annotation)

    polyphen2_value, polyphen2_caption = _fmt_predictor_grid_entry(polyphen2_score, polyphen2_code, polyphen2_label)
    sift_value, sift_caption = _fmt_predictor_grid_entry(sift_score, sift_code, sift_label)
    mt_value, mt_caption = _fmt_predictor_grid_entry(mt_score, mt_code, mt_label)

    render_compact_metric_grid([
        ("REVEL", _fmt_score(revel_val)),
        ("AlphaMissense", _fmt_score(alpha_val)),
        ("CADD phred", _fmt_score(cadd_val, decimals=2)),
        ("PolyPhen2 (HDIV)", polyphen2_value, polyphen2_caption),
        ("SIFT", sift_value, sift_caption),
        ("MutationTaster", mt_value, mt_caption),
    ], columns=6)

    splice_val = case_kwargs["spliceai_delta"]
    if splice_val is not None:
        st.caption(
            f"Splice-impact proxy (dbscSNV ADA/RF max, standing in for SpliceAI \u2014 "
            f"dbNSFP does not itself carry SpliceAI): {splice_val:.3f}"
        )

    rows = dbnsfp_acmg_table_rows(annotation, case_kwargs)
    if rows:
        st.subheader("Total scores")
        st.table(rows)
        has_standalone = any(r["Points"] == "Stand-alone" for r in rows)
        if has_standalone:
            st.markdown("**Total points:** Stand-alone (BA1)")
            classification = "Benign / Likely Benign"
        else:
            total = sum(int(r["Points"]) for r in rows)
            st.markdown(f"**Total points:** {total:+d}")
            classification = classify_from_points(total)
        st.markdown(f"**Classification based on these scores:** {badge(classification)}", unsafe_allow_html=True)
    else:
        st.info("No population-frequency or REVEL-based criteria triggered by the scores above.")


render_dbnsfp_case_section()
