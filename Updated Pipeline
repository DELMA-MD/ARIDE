"""
acmg_core.py — ACMG/AMP variant classification engine.

Pure logic plus annotation retrieval. No Streamlit import, so this module can be
imported from a notebook, a batch script, or a test suite — which is what makes
the VUS pipeline verifiable instead of dormant.

Every threshold constant carries its source inline. Full citations are in the
project document "ACMG/AMP Criteria Reference".

Design rule: there is exactly ONE scoring path. `assess_annotation()` builds
evidence lines; `VUSResolutionPipeline` extends the same evidence list; both
end at `classify_from_points()`. The previous version had two independent
scoring implementations that disagreed with each other.
"""

from __future__ import annotations

import math
import time
from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Optional

import requests

