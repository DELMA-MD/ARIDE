    "DiseaseModel", "FrequencyEvidence", "InSilicoEvidence",
    "AutomatedAssessment", "assess_annotation",
    "VariantCase", "PipelineResult", "VUSResolutionPipeline",
    "query_myvariant", "query_clinvar", "parse_annotation",
]


# =====================================================================
# 1. Evidence strength
# =====================================================================

class Strength(Enum):
    """ACMG evidence strength tiers, with Tavtigian (2020) point weights.

    FIX — this was a genuine bug. The previous version declared
    ``VERY_STRONG = 8`` and ``STAND_ALONE = 8``. Python's Enum collapses
    duplicate values into aliases, so ``Strength.STAND_ALONE is
    Strength.VERY_STRONG`` evaluated True and every PVS1 Very Strong variant
    was reported as "stand-alone", skipping the point total entirely.
    Tuple values keep the two members distinct.
    """

    STAND_ALONE = ("StandAlone", 8)
    VERY_STRONG = ("VeryStrong", 8)
    STRONG = ("Strong", 4)
    MODERATE = ("Moderate", 2)
    SUPPORTING = ("Supporting", 1)

    def __init__(self, label: str, points: int) -> None:
        self.label = label
        self.points = points

    def __str__(self) -> str:  # pragma: no cover - display only
        return self.label


# --- Criterion registry ----------------------------------------------

PATHOGENIC_CODES = frozenset({
    "PVS1",
    "PS1", "PS2", "PS3", "PS4",
    "PM1", "PM2", "PM3", "PM4", "PM5", "PM6",
    "PP1", "PP2", "PP3", "PP4", "PP5",
})

BENIGN_CODES = frozenset({
    "BA1",
    "BS1", "BS2", "BS3", "BS4",
    "BP1", "BP2", "BP3", "BP4", "BP5", "BP6", "BP7",
})

ALL_CODES = PATHOGENIC_CODES | BENIGN_CODES

#: Withdrawn by ClinGen SVI in 2018 (Biesecker & Harrison, Genet Med 20:1687).
#: They double-count another laboratory's evidence. Never emit these.
RETIRED_CODES = frozenset({"PP5", "BP6"})

#: Pairs that can never be co-applied to a single variant.
MUTUALLY_EXCLUSIVE: tuple[tuple[str, str], ...] = (
    ("PS1", "PM5"),    # same-residue evidence, one or the other
    ("PM4", "BP3"),    # in-frame indel: non-repeat vs repeat region
    ("PVS1", "PM4"),   # protein-length change is subsumed by PVS1
    ("PP3", "BP4"),    # computational evidence points one way only
)


@dataclass
class EvidenceLine:
    """One applied ACMG criterion at a chosen strength."""

    code: str
    strength: Strength
    step: str = ""
    note: str = ""

    def __post_init__(self) -> None:
        code = self.code.upper()
        if code in RETIRED_CODES:
            raise ValueError(
                f"{code} was retired by ClinGen SVI (2018) and must not be applied. "
                "Retrieve and evaluate the underlying evidence directly instead."
            )
        if code not in ALL_CODES:
            raise ValueError(f"{code} is not an ACMG/AMP criterion.")
        self.code = code

    @property
    def is_benign(self) -> bool:
        return self.code in BENIGN_CODES

    @property
    def is_standalone(self) -> bool:
        """BA1 only. Terminal — ends the evaluation, not merely -8 points."""
        return self.strength is Strength.STAND_ALONE

    @property
    def points(self) -> int:
        return (-1 if self.is_benign else 1) * self.strength.points

    @property
    def points_display(self) -> str:
        return "Stand-alone" if self.is_standalone else f"{self.points:+d}"


def check_mutual_exclusivity(evidence: list[EvidenceLine]) -> list[str]:
    """Return a human-readable conflict for each illegal criterion pair found."""
    codes = {e.code for e in evidence}
    return [
        f"{a} and {b} cannot both be applied to one variant"
        for a, b in MUTUALLY_EXCLUSIVE
        if a in codes and b in codes
    ]


# =====================================================================
# 2. Classification bands
# =====================================================================

class Classification(Enum):
    PATHOGENIC = "Pathogenic"
    LIKELY_PATHOGENIC = "Likely Pathogenic"
    VUS = "Uncertain Significance"
    LIKELY_BENIGN = "Likely Benign"
    BENIGN = "Benign"

    def __str__(self) -> str:  # pragma: no cover - display only
        return self.value


def classify_from_points(total: int) -> Classification:
    """Tavtigian (2020) naturally scaled point bands.

    FIX — the previous version collapsed Likely Benign and Benign into one
    label for everything <= -1. The boundary belongs at -7: a single Strong
    benign criterion (-4) is Likely Benign, and two (-8) are Benign, which
    is what the 2015 qualitative rule "either 1 BA1 or >= 2 BS" encodes.
    """
    if total >= 10:
        return Classification.PATHOGENIC
    if 6 <= total <= 9:
        return Classification.LIKELY_PATHOGENIC
    if total >= 0:                      # 0 to 5
        return Classification.VUS
    if total >= -6:                     # -1 to -6
        return Classification.LIKELY_BENIGN
    return Classification.BENIGN        # <= -7


def classify_evidence(evidence: list[EvidenceLine]) -> tuple[Classification, Optional[int]]:
    """Classify an evidence list. Returns (classification, total_points).

    BA1 is terminal: it returns Benign with ``None`` points, because it is not
    an -8 contribution that other evidence can argue down.
    """
    if any(e.is_standalone for e in evidence):
        return Classification.BENIGN, None
    total = sum(e.points for e in evidence)
    return classify_from_points(total), total


# =====================================================================
# 3. Variant and disease context
# =====================================================================

class Inheritance(Enum):
    AR = "autosomal_recessive"
    AD = "autosomal_dominant"
    XL = "x_linked"


class MolecularClass(Enum):
    TRUNCATING = "truncating"            # nonsense / frameshift / canonical +-1,2 / start-loss
    MISSENSE = "missense"
    INFRAME_INDEL = "inframe_indel"      # in-frame indel / stop-loss
    SYNONYMOUS = "synonymous"            # BP7 candidate
    SPLICE_REGION = "splice_region"      # non-canonical near-splice
    INTRONIC_OR_UTR = "intronic_or_utr"  # deep intronic / UTR
    OTHER = "other"

    @property
    def is_splice_like(self) -> bool:
        return self in (
            MolecularClass.SYNONYMOUS,
            MolecularClass.SPLICE_REGION,
            MolecularClass.INTRONIC_OR_UTR,
        )

    @property
    def is_protein_altering(self) -> bool:
        return self in (MolecularClass.MISSENSE, MolecularClass.INFRAME_INDEL)


class GeneValidity(Enum):
    DEFINITIVE = "definitive"
    STRONG = "strong"
    MODERATE = "moderate"
    LIMITED = "limited"
    DISPUTED = "disputed"
    REFUTED = "refuted"
    NO_KNOWN = "no_known_disease_relationship"

    @property
    def supports_classification(self) -> bool:
        """Below Moderate, a variant cannot rise above VUS however strong the
        variant-level evidence (Strande 2017; ClinGen gene-disease validity)."""
        return self in (GeneValidity.DEFINITIVE, GeneValidity.STRONG, GeneValidity.MODERATE)


class Zygosity(Enum):
    HOM_AR = "homozygous_in_AR_gene"
    COMP_HET_AR = "two_het_same_AR_gene"
    SINGLE_HET_AR = "single_het_in_AR_gene"
    HET_DOMINANT = "het_in_dominant_gene"
    HEMI_XL_MALE = "hemizygous_x_linked_male"


@dataclass(frozen=True)
class DiseaseModel:
    """Parameters for the Whiffin (2017) maximum credible allele frequency.

    FIX — the previous version hardcoded BS1 at 1e-4 for every gene and every
    disease. That cutoff has no basis in the guideline (Richards 2015 defines
    BS1 only qualitatively) and systematically misclassifies recessive founder
    alleles. Compute the ceiling from the disease instead.
    """

    name: str = "generic autosomal recessive rare disease"
    inheritance: Inheritance = Inheritance.AR
    prevalence: float = 1 / 3000          # all inherited retinal disease combined
    max_gene_contribution: float = 0.10   # largest share of cases from one gene
    max_allelic_contribution: float = 0.05  # largest share within that gene
    penetrance: float = 1.0

    @property
    def max_credible_af(self) -> float:
        """Allele-frequency ceiling above which the variant cannot be causal.

        genotype frequency = prevalence x gene share x allele share / penetrance
        Biallelic: AF = sqrt(genotype frequency).
        Monoallelic: AF ~= genotype frequency / 2 for rare alleles.
        """
        genotype_freq = (
            self.prevalence
            * self.max_gene_contribution
            * self.max_allelic_contribution
            / max(self.penetrance, 1e-9)
        )
        if self.inheritance == Inheritance.AR:
            return math.sqrt(genotype_freq)
        return genotype_freq / 2.0


# =====================================================================
# 4. Evidence inputs
# =====================================================================

#: Richards 2015: BA1 is allele frequency > 5%.
BA1_ALLELE_FREQUENCY = 0.05

#: Minimum gnomAD allele number for "absent" to mean absent rather than
#: uncalled. gnomAD v4 exomes carry AN ~1.46M at well-covered sites; this is a
#: deliberately conservative floor. Tune per your callset.
MIN_ALLELE_NUMBER_FOR_ABSENCE = 100_000

# --- REVEL, calibrated by Pejaver 2022 (ClinGen SVI endorsed) ---------
REVEL_PP3_STRONG = 0.932
REVEL_PP3_MODERATE = 0.773
REVEL_PP3_SUPPORTING = 0.644
REVEL_BP4_SUPPORTING = 0.290
REVEL_BP4_MODERATE = 0.183
REVEL_BP4_STRONG = 0.016
REVEL_BP4_VERY_STRONG = 0.003   # was missing from the previous implementation

# --- AlphaMissense, Cheng 2023 (fallback when REVEL is unavailable) ---
ALPHAMISSENSE_PATHOGENIC = 0.564
ALPHAMISSENSE_BENIGN = 0.340

# --- SpliceAI, Jaganathan 2019 ---------------------------------------
SPLICEAI_PP3_MODERATE = 0.5
SPLICEAI_PP3_SUPPORTING = 0.2
SPLICEAI_BP4 = 0.1

# --- dbscSNV ADA/RF, Jian 2014 ---------------------------------------
# FIX — the previous version fed the ADA/RF score into SpliceAI's 0.5/0.2
# thresholds. Different classifiers, different training sets, different
# scales. dbscSNV has its own published cutoff and only covers +-3/+-8 bp.
DBSCSNV_CUTOFF = 0.6

# --- Conservation, for the second arm of BP7 -------------------------
PHYLOP_CONSERVED = 1.0
GERP_CONSERVED = 2.0


@dataclass
class FrequencyEvidence:
    """Population frequency, with enough context to tell absent from uncalled.

    FIX — the previous ``dbnsfp_popmax_af()`` returned 0.0 both when a variant
    was genuinely absent from gnomAD and when the gnomAD block was missing from
    the API response, so a lookup failure silently awarded PM2.
    """

    popmax_af: Optional[float] = None      # None = no gnomAD record at all
    faf95: Optional[float] = None          # true filtering AF, when available
    allele_number: int = 0
    hom_count: int = 0
    hemi_count: int = 0
    source: str = ""

    @property
    def in_gnomad(self) -> bool:
        return self.popmax_af is not None

    @property
    def observed(self) -> bool:
        return bool(self.popmax_af)

    @property
    def adequately_covered(self) -> bool:
        return self.allele_number >= MIN_ALLELE_NUMBER_FOR_ABSENCE

    @property
    def uses_point_estimate(self) -> bool:
        """True when we fell back to popmax AF because no FAF was available.
        Whiffin 2017 specifies the 95% CI lower bound, not the point estimate."""
        return self.faf95 is None and self.popmax_af is not None

    @property
    def effective_af(self) -> Optional[float]:
        if self.faf95 is not None:
            return self.faf95
        return self.popmax_af


@dataclass
class InSilicoEvidence:
    """Predictor scores. Scored and display-only fields are kept separate so
    that an uncalibrated tool can never leak into an ACMG criterion."""

    # Calibrated — these may generate PP3/BP4
    revel: Optional[float] = None
    alphamissense: Optional[float] = None
    spliceai_delta: Optional[float] = None   # true SpliceAI, if you supply it
    dbscsnv_max: Optional[float] = None      # ADA/RF, own 0.6 scale

    # Conservation — second arm of BP7 only
    phylop: Optional[float] = None
    gerp: Optional[float] = None

    # Display only. CADD is not calibrated for ACMG evidence strength and
    # must not drive PP3 (Pejaver 2022 discussion).
    cadd_phred: Optional[float] = None
    polyphen2: Optional[tuple[Optional[float], Optional[str], Optional[str]]] = None
    sift: Optional[tuple[Optional[float], Optional[str], Optional[str]]] = None
    mutationtaster: Optional[tuple[Optional[float], Optional[str], Optional[str]]] = None


# --- Criterion evaluators --------------------------------------------

def evaluate_frequency(
    freq: FrequencyEvidence,
    disease: DiseaseModel,
    step: str = "Frequency",
) -> tuple[list[EvidenceLine], list[str]]:
    """BA1, BS1, BS2 and PM2 from population data."""
    lines: list[EvidenceLine] = []
    caveats: list[str] = []

    if not freq.in_gnomad:
        caveats.append(
            "No gnomAD record returned — frequency criteria (BA1/BS1/BS2/PM2) "
            "not assessed. Absence from the API is not absence from the population."
        )
        return lines, caveats

    af = freq.effective_af or 0.0
    ceiling = disease.max_credible_af

    if freq.uses_point_estimate:
        caveats.append(
            "Frequency criteria used popmax point-estimate AF; no FAF95 available. "
            "Whiffin 2017 specifies the 95% CI lower bound."
        )

    if af > BA1_ALLELE_FREQUENCY:
        lines.append(EvidenceLine(
            "BA1", Strength.STAND_ALONE, step,
            f"popmax AF {af:.2e} > 5% — check the ClinGen BA1 exception list before finalising",
        ))
        return lines, caveats  # terminal; nothing else is evaluated

    if af > ceiling:
        lines.append(EvidenceLine(
            "BS1", Strength.STRONG, step,
            f"popmax AF {af:.2e} exceeds the max credible AF {ceiling:.2e} "
            f"for {disease.name}",
        ))
    elif not freq.observed:
        if freq.adequately_covered:
            # ClinGen SVI 2020: PM2 is Supporting, not Moderate. Rarity alone
            # is weak evidence.
            lines.append(EvidenceLine(
                "PM2", Strength.SUPPORTING, step,
                f"absent from gnomAD at adequate depth (AN={freq.allele_number:,})",
            ))
        else:
            caveats.append(
                f"PM2 not applied: gnomAD allele number is only {freq.allele_number:,}, "
                f"below the {MIN_ALLELE_NUMBER_FOR_ABSENCE:,} floor for calling a site "
                "genuinely absent rather than uncalled."
            )
    elif disease.inheritance == Inheritance.AR and af < ceiling / 10:
        lines.append(EvidenceLine(
            "PM2", Strength.SUPPORTING, step,
            f"popmax AF {af:.2e} is more than tenfold below the credible ceiling",
        ))

    # BS2 — healthy homozygotes / hemizygotes
    if disease.inheritance == Inheritance.AR and freq.hom_count > 0:
        strength = Strength.STRONG if freq.hom_count >= 2 else Strength.SUPPORTING
        lines.append(EvidenceLine(
            "BS2", strength, step,
            f"{freq.hom_count} homozygote(s) in gnomAD, which is not screened for "
            f"{disease.name}",
        ))
    elif disease.inheritance == Inheritance.XL and freq.hemi_count > 0:
        strength = Strength.STRONG if freq.hemi_count >= 2 else Strength.SUPPORTING
        lines.append(EvidenceLine(
            "BS2", strength, step, f"{freq.hemi_count} hemizygote(s) in gnomAD",
        ))
    elif disease.inheritance == Inheritance.AD and freq.observed:
        caveats.append(
            "BS2 for a dominant disorder needs age-matched, phenotype-screened controls. "
            "gnomAD heterozygote counts alone cannot establish it."
        )

    return lines, caveats


def evaluate_missense_insilico(
    insilico: InSilicoEvidence,
    step: str = "InSilico",
) -> tuple[Optional[EvidenceLine], list[str]]:
    """PP3 / BP4 for missense and in-frame variants.

    Uses exactly ONE predictor, preferring REVEL because its thresholds are the
    ones ClinGen endorsed. Running several tools and counting agreement is
    statistically invalid: they share training data and component scores, so
    their concordance is not independent evidence.
    """
    revel = insilico.revel
    if revel is not None:
        if revel >= REVEL_PP3_STRONG:
            return EvidenceLine("PP3", Strength.STRONG, step, f"REVEL {revel:.3f} >= {REVEL_PP3_STRONG}"), []
        if revel >= REVEL_PP3_MODERATE:
            return EvidenceLine("PP3", Strength.MODERATE, step, f"REVEL {revel:.3f} >= {REVEL_PP3_MODERATE}"), []
        if revel >= REVEL_PP3_SUPPORTING:
            return EvidenceLine("PP3", Strength.SUPPORTING, step, f"REVEL {revel:.3f} >= {REVEL_PP3_SUPPORTING}"), []
        if revel <= REVEL_BP4_VERY_STRONG:
            return EvidenceLine("BP4", Strength.VERY_STRONG, step, f"REVEL {revel:.3f} <= {REVEL_BP4_VERY_STRONG}"), []
        if revel <= REVEL_BP4_STRONG:
            return EvidenceLine("BP4", Strength.STRONG, step, f"REVEL {revel:.3f} <= {REVEL_BP4_STRONG}"), []
        if revel <= REVEL_BP4_MODERATE:
            return EvidenceLine("BP4", Strength.MODERATE, step, f"REVEL {revel:.3f} <= {REVEL_BP4_MODERATE}"), []
        if revel <= REVEL_BP4_SUPPORTING:
            return EvidenceLine("BP4", Strength.SUPPORTING, step, f"REVEL {revel:.3f} <= {REVEL_BP4_SUPPORTING}"), []
        return None, [
            f"REVEL {revel:.3f} falls in the indeterminate band "
            f"({REVEL_BP4_SUPPORTING}-{REVEL_PP3_SUPPORTING}); no computational criterion applied."
        ]

    alpha = insilico.alphamissense
    if alpha is not None:
        if alpha >= ALPHAMISSENSE_PATHOGENIC:
            return EvidenceLine("PP3", Strength.SUPPORTING, step, f"AlphaMissense {alpha:.3f} (REVEL unavailable)"), []
        if alpha <= ALPHAMISSENSE_BENIGN:
            return EvidenceLine("BP4", Strength.SUPPORTING, step, f"AlphaMissense {alpha:.3f} (REVEL unavailable)"), []
        return None, [f"AlphaMissense {alpha:.3f} is in the ambiguous band; no criterion applied."]

    return None, ["No calibrated missense predictor available; PP3/BP4 not assessed."]


def evaluate_splice_insilico(
    insilico: InSilicoEvidence,
    step: str = "InSilico",
) -> tuple[Optional[EvidenceLine], list[str]]:
    """PP3 / BP4 for splice-region, synonymous and intronic variants.

    SpliceAI is preferred. dbscSNV is used only as a fallback, on its own 0.6
    scale, and only yields Supporting strength because it covers a narrow
    window and is not calibrated to ACMG evidence tiers.
    """
    delta = insilico.spliceai_delta
    if delta is not None:
        if delta >= SPLICEAI_PP3_MODERATE:
            return EvidenceLine(
                "PP3", Strength.MODERATE, step,
                f"SpliceAI delta {delta:.2f} >= {SPLICEAI_PP3_MODERATE} — confirm with an RNA assay",
            ), []
        if delta >= SPLICEAI_PP3_SUPPORTING:
            return EvidenceLine("PP3", Strength.SUPPORTING, step, f"SpliceAI delta {delta:.2f}"), []
        if delta < SPLICEAI_BP4:
            return EvidenceLine("BP4", Strength.SUPPORTING, step, f"SpliceAI delta {delta:.2f} < {SPLICEAI_BP4}"), []
        return None, [f"SpliceAI delta {delta:.2f} is in the indeterminate band; no criterion applied."]

    ada_rf = insilico.dbscsnv_max
    if ada_rf is not None:
        if ada_rf >= DBSCSNV_CUTOFF:
            return EvidenceLine(
                "PP3", Strength.SUPPORTING, step,
                f"dbscSNV ADA/RF {ada_rf:.3f} >= {DBSCSNV_CUTOFF} (SpliceAI unavailable)",
            ), ["dbscSNV covers only +-3/+-8 bp of the splice consensus; run SpliceAI for a full assessment."]
        return EvidenceLine(
            "BP4", Strength.SUPPORTING, step,
            f"dbscSNV ADA/RF {ada_rf:.3f} < {DBSCSNV_CUTOFF} (SpliceAI unavailable)",
        ), []

    return None, ["No splice predictor available; PP3/BP4 not assessed."]


def evaluate_bp7(
    molecular_class: MolecularClass,
    insilico: InSilicoEvidence,
    step: str = "InSilico",
) -> tuple[Optional[EvidenceLine], list[str]]:
    """BP7 — synonymous variant, splice-quiet AND not conserved.

    Both arms must hold. The conservation arm is the one people skip: a
    synonymous change at a deeply conserved nucleotide may be disrupting an
    exonic splicing enhancer even when splice predictors are quiet.
    """
    if molecular_class != MolecularClass.SYNONYMOUS:
        return None, []

    delta = insilico.spliceai_delta
    ada_rf = insilico.dbscsnv_max
    if delta is not None:
        splice_quiet = delta < SPLICEAI_BP4
    elif ada_rf is not None:
        splice_quiet = ada_rf < DBSCSNV_CUTOFF
    else:
        return None, ["BP7 not assessed: no splice predictor available."]

    phylop, gerp = insilico.phylop, insilico.gerp
    if phylop is not None:
        conserved = phylop >= PHYLOP_CONSERVED
        cons_note = f"phyloP {phylop:.2f}"
    elif gerp is not None:
        conserved = gerp >= GERP_CONSERVED
        cons_note = f"GERP++ {gerp:.2f}"
    else:
        return None, ["BP7 not assessed: no conservation score available (second arm of the rule)."]

    if splice_quiet and not conserved:
        return EvidenceLine("BP7", Strength.SUPPORTING, step, f"synonymous, splice-quiet, {cons_note}"), []
    if splice_quiet and conserved:
        return None, [f"BP7 withheld: splice-quiet but the nucleotide is conserved ({cons_note})."]
    return None, []


# =====================================================================
# 5. Automated assessment (what a database lookup alone can support)
# =====================================================================

#: Criteria that no annotation API can decide on its own.
NOT_AUTOMATABLE = {
    "PVS1": "run AutoPVS1 or the ClinGen NMD decision tree",
    "PS1": "residue-level ClinVar lookup plus a splice check on the new nucleotide",
    "PS2": "trio data with confirmed parentage",
    "PS3": "published functional assay, OddsPath-calibrated",
    "PS4": "case-control or proband counting",
    "PM1": "domain and hot-spot curation",
    "PM3": "confirmed phase with a second pathogenic allele",
    "PM5": "residue-level ClinVar lookup",
    "PM6": "trio data without confirmed parentage",
    "PP1": "pedigree segregation",
    "PP2": "gene-level missense constraint review",
    "PP4": "phenotype specificity assessment",
    "BS3": "published functional assay",
    "BS4": "pedigree segregation",
    "BP1": "gene mechanism review",
    "BP2": "confirmed phase",
    "BP5": "alternate molecular diagnosis in the same case",
}


@dataclass
class AutomatedAssessment:
    """Result of the subset of ACMG that a gnomAD + predictor lookup supports."""

    evidence: list[EvidenceLine] = field(default_factory=list)
    caveats: list[str] = field(default_factory=list)
    conflicts: list[str] = field(default_factory=list)
    molecular_class: MolecularClass = MolecularClass.OTHER
    disease: DiseaseModel = field(default_factory=DiseaseModel)

    @property
    def standalone(self) -> bool:
        return any(e.is_standalone for e in self.evidence)

    @property
    def total_points(self) -> Optional[int]:
        return None if self.standalone else sum(e.points for e in self.evidence)

    @property
    def classification(self) -> Classification:
        return classify_evidence(self.evidence)[0]

    @property
    def points_display(self) -> str:
        return "Stand-alone (BA1)" if self.standalone else f"{self.total_points:+d}"

    def table_rows(self, descriptions: dict[str, str], bases: dict[str, str]) -> list[dict[str, str]]:
        rows = []
        for e in self.evidence:
            desc = descriptions.get(e.code, "-")
            basis = bases.get(e.code)
            rows.append({
                "Criterion": e.code,
                "Description": f"{desc} — based on {basis}" if basis else desc,
                "Strength": e.strength.label,
                "Points": e.points_display,
                "Detail": e.note,
            })
        return rows


def assess_annotation(
    freq: FrequencyEvidence,
    insilico: InSilicoEvidence,
    molecular_class: MolecularClass,
    disease: Optional[DiseaseModel] = None,
    in_repeat_region: Optional[bool] = None,
) -> AutomatedAssessment:
    """Apply every criterion that annotation data alone can support."""
    disease = disease or DiseaseModel()
    result = AutomatedAssessment(molecular_class=molecular_class, disease=disease)

    freq_lines, freq_caveats = evaluate_frequency(freq, disease)
    result.evidence.extend(freq_lines)
    result.caveats.extend(freq_caveats)

    if result.standalone:
        result.caveats.append("BA1 is terminal — no further criteria were evaluated.")
        return result

    if molecular_class.is_protein_altering:
        line, notes = evaluate_missense_insilico(insilico)
        if line:
            result.evidence.append(line)
        result.caveats.extend(notes)
    elif molecular_class.is_splice_like:
        line, notes = evaluate_splice_insilico(insilico)
        if line:
            result.evidence.append(line)
        result.caveats.extend(notes)
        bp7, bp7_notes = evaluate_bp7(molecular_class, insilico)
        if bp7 and not any(e.code == "PP3" for e in result.evidence):
            result.evidence.append(bp7)
        result.caveats.extend(bp7_notes)
    elif molecular_class == MolecularClass.TRUNCATING:
        result.caveats.append(
            "Truncating variant: PVS1 requires the NMD decision tree (last exon / "
            "last 50 bp of the penultimate exon) and confirmation that LoF is the "
            "gene's mechanism. Not applied automatically."
        )

    # PM4 / BP3 need repeat-region context, which the API does not supply.
    if molecular_class == MolecularClass.INFRAME_INDEL:
        if in_repeat_region is False:
            result.evidence.append(EvidenceLine(
                "PM4", Strength.MODERATE, "Consequence", "in-frame indel outside a repeat region"))
        elif in_repeat_region is True:
            result.evidence.append(EvidenceLine(
                "BP3", Strength.SUPPORTING, "Consequence", "in-frame indel within a repeat region"))
        else:
            result.caveats.append(
                "In-frame indel: PM4 and BP3 are mutually exclusive and depend on whether "
                "the indel sits in a repeat or low-complexity region. Check RepeatMasker "
                "or the UniProt repeat annotation, then set in_repeat_region."
            )

    applied = {e.code for e in result.evidence}
    missing = sorted(set(NOT_AUTOMATABLE) - applied)
    if missing:
        result.caveats.append(
            "Not assessed (manual curation required): " + ", ".join(missing) + "."
        )

    result.conflicts = check_mutual_exclusivity(result.evidence)
    return result


