def build_genomic_hgvs(chrom: str, pos: str, ref: str, alt: str) -> str:
    """('3', '97784972', 'T', 'C') -> 'chr3:g.97784972T>C'."""
    c = str(chrom).strip().lower().replace("chr", "")
    return f"chr{c}:g.{str(pos).strip()}{str(ref).strip().upper()}>{str(alt).strip().upper()}"


def _get_json(url: str, params: dict, timeout: int = 20, retries: int = 3) -> Any:
    last_err: Optional[Exception] = None
    for attempt in range(retries):
        try:
            resp = requests.get(url, params=params, headers={"Accept": "application/json"},
                                timeout=timeout)
            if resp.status_code == 404:
                return {"_http_404": True}
            resp.raise_for_status()
            return resp.json()
        except Exception as exc:                     # noqa: BLE001
            last_err = exc
            if attempt < retries - 1:
                time.sleep(1 + attempt)
    raise last_err if last_err else RuntimeError("request failed")


def query_myvariant(chrom: str, pos: str, ref: str, alt: str,
                    assembly: str = "hg38", timeout: int = 20) -> dict:
    hgvs = build_genomic_hgvs(chrom, pos, ref, alt)
    params = {"fields": MYVARIANT_FIELDS}
    if assembly:
        params["assembly"] = assembly
    try:
        data = _get_json(MYVARIANT_URL_TMPL.format(hgvs=hgvs), params, timeout=timeout)
    except Exception as exc:                          # noqa: BLE001
        return {"error": str(exc), "hgvs": hgvs}

    if isinstance(data, dict) and data.get("_http_404"):
        return {"error": f"No annotation record for {hgvs}.", "hgvs": hgvs}
    if isinstance(data, dict) and data.get("success") is False:
        return {"error": data.get("error", "No annotation returned."), "hgvs": hgvs}

    data["_hgvs"] = hgvs
    return data


# --- ClinVar -----------------------------------------------------------

import re as _re

_C_NOTATION = _re.compile(r":(c\.[^\s(]+)")


def extract_c_notation(title: str) -> str:
    match = _C_NOTATION.search(title or "")
    return match.group(1).strip() if match else ""


def query_clinvar(gene: str, variant: str, retries: int = 3) -> list[dict]:
    term = f'{gene}[gene] AND "{variant}"[Variant name]'
    params = {"db": "clinvar", "term": term, "retmode": "json", "retmax": 20}

    payload = _get_json(ESEARCH_URL, params, retries=retries)
    ids = (payload or {}).get("esearchresult", {}).get("idlist", [])

    if not ids:
        params["term"] = f"{gene}[gene] AND {variant}"
        payload = _get_json(ESEARCH_URL, params, retries=retries)
        ids = (payload or {}).get("esearchresult", {}).get("idlist", [])

    if not ids:
        return []

    summary = _get_json(ESUMMARY_URL, {"db": "clinvar", "id": ",".join(ids), "retmode": "json"},
                        retries=retries)
    result = (summary or {}).get("result", {})

    wanted = variant.strip().lower()
    records = []
    for uid in ids:
        rec = result.get(uid)
        if not rec:
            continue
        title = rec.get("title", "")
        if extract_c_notation(title).lower() != wanted:
            continue
        germline = rec.get("germline_classification", {}) or {}
        raw_date = germline.get("last_evaluated", "") or ""
        records.append({
            "accession": rec.get("accession", uid),
            "title": title,
            "classification": germline.get("description", "Not provided"),
            "review_status": germline.get("review_status", ""),
            "last_evaluated": raw_date.split(" ")[0] if raw_date else "",
            "link": f"https://www.ncbi.nlm.nih.gov/clinvar/variation/{uid}/",
        })
    return records


