def _first_present(d: dict, *paths: str, default: Any = None) -> Any:
    for path in paths:
        node: Any = d
        ok = True
        for key in path.split("."):
            if isinstance(node, list):
                node = node[0] if node else None
            if isinstance(node, dict) and key in node:
                node = node[key]
            else:
                ok = False
                break
        if ok and node is not None:
            return node
    return default


def _flatten(val: Any) -> list[Any]:
    if val is None:
        return []
    if not isinstance(val, list):
        return [val]
    out: list[Any] = []
    for v in val:
        out.extend(_flatten(v))
    return out


def _worst_score(val: Any, higher_is_more_damaging: bool = True) -> Optional[float]:
    nums = []
    for v in _flatten(val):
        try:
            nums.append(float(v))
        except (TypeError, ValueError):
            continue
    if not nums:
        return None
    return max(nums) if higher_is_more_damaging else min(nums)


def _worst_pred(val: Any, severity_rank: list[str]) -> Optional[str]:
    codes = {str(v) for v in _flatten(val)}
    if not codes:
        return None
    for code in severity_rank:
        if code in codes:
            return code
    return next(iter(codes))


POLYPHEN2_LABELS = {"D": "Probably damaging", "P": "Possibly damaging", "B": "Benign"}
POLYPHEN2_RANK = ["D", "P", "B"]
SIFT_LABELS = {"D": "Deleterious", "T": "Tolerated"}
SIFT_RANK = ["D", "T"]
MUTATIONTASTER_LABELS = {
    "A": "Disease causing (high confidence)",
    "D": "Disease causing",
    "N": "Polymorphism (benign)",
    "P": "Polymorphism (high confidence benign)",
}
MUTATIONTASTER_RANK = ["A", "D", "N", "P"]

TRUNCATING_EFFECTS = {
    "stop_gained", "stop gained", "frameshift_variant", "frameshift variant",
    "splice_donor_variant", "splice donor variant",
    "splice_acceptor_variant", "splice acceptor variant",
    "start_lost", "start lost", "initiator_codon_variant",
}
INFRAME_EFFECTS = {
    "inframe_deletion", "inframe deletion", "inframe_insertion", "inframe insertion",
    "stop_lost", "stop lost", "nonframeshift deletion", "nonframeshift insertion",
}
MISSENSE_EFFECTS = {"missense_variant", "missense variant", "nonsynonymous snv"}
SYNONYMOUS_EFFECTS = {"synonymous_variant", "synonymous variant", "synonymous snv"}
SPLICE_REGION_EFFECTS = {"splice_region_variant", "splice region variant"}
INTRONIC_EFFECTS = {
    "intron_variant", "intron variant", "intronic",
    "5_prime_utr_variant", "3_prime_utr_variant",
}


def parse_molecular_class(annotation: dict) -> MolecularClass:
    """Map the annotated consequence onto a MolecularClass.

    FIX — the previous version listed ``dbnsfp.genename`` as a fallback path for
    the consequence string, then had to re-derive the value on the next line.
    The dead path is gone and the consequence list is searched properly.
    """
    raw = _first_present(
        annotation,
        "dbnsfp.ensembl.consequence",
        "dbnsfp.vep.consequence",
        "cadd.consequence",
        default=None,
    )
    effects = {str(e).strip().lower() for e in _flatten(raw)}
    if not effects:
        return MolecularClass.OTHER
    if effects & TRUNCATING_EFFECTS:
        return MolecularClass.TRUNCATING
    if effects & INFRAME_EFFECTS:
        return MolecularClass.INFRAME_INDEL
    if effects & MISSENSE_EFFECTS:
        return MolecularClass.MISSENSE
    if effects & SYNONYMOUS_EFFECTS:
        return MolecularClass.SYNONYMOUS
    if effects & SPLICE_REGION_EFFECTS:
        return MolecularClass.SPLICE_REGION
    if effects & INTRONIC_EFFECTS:
        return MolecularClass.INTRONIC_OR_UTR
    return MolecularClass.OTHER


def parse_frequency(annotation: dict) -> FrequencyEvidence:
    """Build FrequencyEvidence, distinguishing absent from uncalled."""
    faf = _worst_score(_first_present(
        annotation,
        "gnomad_exome.faf95.faf95_popmax", "gnomad_genome.faf95.faf95_popmax",
        "gnomad_exome.faf95_popmax", "gnomad_genome.faf95_popmax",
    ))

    popmax = _worst_score(_first_present(
        annotation,
        "dbnsfp.gnomad4.1_joint.af_popmax",
        "dbnsfp.gnomad.af_popmax",
        "dbnsfp.gnomad4.af_popmax_joint",
    ))

    allele_number = 0
    hom = 0
    hemi = 0
    sources: list[str] = []
    per_pop: list[float] = []

    for src in ("gnomad_exome", "gnomad_genome"):
        block = annotation.get(src) or {}
        if not isinstance(block, dict) or not block:
            continue
        sources.append(src)

        af_block = block.get("af")
        if isinstance(af_block, dict):
            for key, val in af_block.items():
                if key.startswith("af_") and isinstance(val, (int, float)):
                    per_pop.append(float(val))
            if isinstance(af_block.get("af"), (int, float)):
                per_pop.append(float(af_block["af"]))
        elif isinstance(af_block, (int, float)):
            per_pop.append(float(af_block))

        an_block = block.get("an")
        if isinstance(an_block, dict):
            an_val = an_block.get("an")
            if isinstance(an_val, (int, float)):
                allele_number = max(allele_number, int(an_val))
        elif isinstance(an_block, (int, float)):
            allele_number = max(allele_number, int(an_block))

        hom_block = block.get("hom")
        if isinstance(hom_block, dict):
            hom += sum(int(v) for v in hom_block.values() if isinstance(v, (int, float)))
        elif isinstance(hom_block, (int, float)):
            hom += int(hom_block)

        hemi_block = block.get("hemi")
        if isinstance(hemi_block, dict):
            hemi += sum(int(v) for v in hemi_block.values() if isinstance(v, (int, float)))
        elif isinstance(hemi_block, (int, float)):
            hemi += int(hemi_block)

    if popmax is None and per_pop:
        popmax = max(per_pop)

    # popmax stays None when nothing gnomAD-shaped came back: absent from the
    # API is not absent from the population.
    if popmax is None and not sources:
        return FrequencyEvidence(source="none")

    return FrequencyEvidence(
        popmax_af=popmax if popmax is not None else 0.0,
        faf95=faf,
        allele_number=allele_number,
        hom_count=hom,
        hemi_count=hemi,
        source="+".join(sources) or "dbnsfp",
    )


def parse_insilico(annotation: dict) -> InSilicoEvidence:
    pp2_score = _worst_score(_first_present(
        annotation,
        "dbnsfp.polyphen2.hdiv.score", "dbnsfp.polyphen2_hdiv_score",
        "dbnsfp.polyphen2.hvar.score", "dbnsfp.polyphen2_hvar_score",
    ))
    pp2_code = _worst_pred(_first_present(
        annotation,
        "dbnsfp.polyphen2.hdiv.pred", "dbnsfp.polyphen2_hdiv_pred",
        "dbnsfp.polyphen2.hvar.pred", "dbnsfp.polyphen2_hvar_pred",
    ), POLYPHEN2_RANK)

    sift_score = _worst_score(
        _first_present(annotation, "dbnsfp.sift.score", "dbnsfp.sift_score"),
        higher_is_more_damaging=False,
    )
    sift_code = _worst_pred(
        _first_present(annotation, "dbnsfp.sift.pred", "dbnsfp.sift_pred"), SIFT_RANK)

    mt_score = _worst_score(_first_present(
        annotation, "dbnsfp.mutationtaster.score", "dbnsfp.mutationtaster_score"))
    mt_code = _worst_pred(_first_present(
        annotation, "dbnsfp.mutationtaster.pred", "dbnsfp.mutationtaster_pred"),
        MUTATIONTASTER_RANK)

    ada = _first_present(annotation, "dbscsnv.ada_score", "dbnsfp.dbscsnv.ada_score")
    rf = _first_present(annotation, "dbscsnv.rf_score", "dbnsfp.dbscsnv.rf_score")
    dbscsnv_vals = [v for v in (_worst_score(ada), _worst_score(rf)) if v is not None]

    return InSilicoEvidence(
        revel=_worst_score(_first_present(annotation, "dbnsfp.revel.score", "dbnsfp.revel_score")),
        alphamissense=_worst_score(_first_present(
            annotation, "dbnsfp.alphamissense.score", "dbnsfp.alphamissense_score")),
        spliceai=None if False else _worst_score(_first_present(
            annotation, "dbnsfp.spliceai.ds_max", "spliceai.ds_max")),
        dbscsnv_max=max(dbscsnv_vals) if dbscsnv_vals else None,
        phylop=_worst_score(_first_present(
            annotation, "dbnsfp.phylo_p100way_vertebrate.score",
            "dbnsfp.phylop100way_vertebrate", "dbnsfp.phylop_100way_vertebrate")),
        gerp=_worst_score(_first_present(
            annotation, "dbnsfp.gerp++.rs", "dbnsfp.gerp++_rs", "dbnsfp.gerp_rs")),
        cadd_phred=_worst_score(_first_present(
            annotation, "cadd.phred", "dbnsfp.cadd.phred", "dbnsfp.cadd_phred")),
        polyphen2=(pp2_score, pp2_code, POLYPHEN2_LABELS.get(pp2_code or "", pp2_code)),
        sift=(sift_score, sift_code, SIFT_LABELS.get(sift_code or "", sift_code)),
        mutationtaster=(mt_score, mt_code, MUTATIONTASTER_LABELS.get(mt_code or "", mt_code)),
    )


def parse_annotation(annotation: dict) -> dict:
    """One call that turns a MyVariant payload into the core's input objects."""
    gene = _first_present(annotation, "dbnsfp.genename", default="")
    if isinstance(gene, list):
        gene = gene[0] if gene else ""

    clinvar = annotation.get("clinvar") or {}
    rcv = clinvar.get("rcv")
    if isinstance(rcv, dict):
        rcv = [rcv]

    return {
        "gene": gene,
        "molecular_class": parse_molecular_class(annotation),
        "frequency": parse_frequency(annotation),
        "insilico": parse_insilico(annotation),
        "rsid": _first_present(annotation, "dbsnp.rsid"),
        "clinvar_variant_id": clinvar.get("variant_id"),
        "clinvar_accessions": [
            r.get("accession") for r in (rcv or []) if isinstance(r, dict) and r.get("accession")
        ],
        "thousand_genomes_af": _worst_score(_first_present(
            annotation, "dbnsfp.1000gp3.af", "dbnsfp.1000gp3.gaf", "dbnsfp.1000gp3_af")),
        "exac_af": _worst_score(_first_present(
            annotation, "exac.af.af", "exac.af", "dbnsfp.exac.af", "dbnsfp.exac_af")),
    }


