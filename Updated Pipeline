@dataclass
class VariantCase:
    variant_id: str
    gene: str
    inheritance: Inheritance = Inheritance.AR
    gene_validity: GeneValidity = GeneValidity.DEFINITIVE
    molecular_class: MolecularClass = MolecularClass.MISSENSE
    disease: DiseaseModel = field(default_factory=DiseaseModel)

    frequency: FrequencyEvidence = field(default_factory=FrequencyEvidence)
    insilico: InSilicoEvidence = field(default_factory=InSilicoEvidence)

    # Step 3a — LoF / NMD
    nmd_competent: Optional[bool] = None
    established_lof_mechanism: bool = True
    removes_critical_region: Optional[bool] = None
    frame_preserving: bool = False

    # Step 4 — genotype
    zygosity: Optional[Zygosity] = None

    # Step 5a — autozygosity
    in_roh: Optional[bool] = None
    roh_length_mb: float = 0.0

    # Step 5b — phasing
    parents_available: Optional[bool] = None
    reads_shared_for_phasing: bool = False
    phase_result: Optional[str] = None            # "trans" | "cis" | None
    trans_allele_is_pathogenic: bool = False      # P/LP vs merely plausible

    # Step 5c — second-allele hunt
    cnv_found: Optional[bool] = None
    cnv_is_null: bool = False
    phenotype_strongly_matches_gene: bool = False
    wgs_deep_intronic_found: Optional[bool] = None
    complex_sv_locus: bool = False
    long_read_resolved: Optional[bool] = None

    # Step 5d — segregation / de novo
    segregates_with_disease: Optional[bool] = None
    informative_meioses: int = 0
    apparent_de_novo: Optional[bool] = None
    de_novo_confirmed: Optional[bool] = None
    phenotype_specificity: str = "consistent"     # "specific" | "consistent" | "nonspecific"

    # Step 6 — functional
    functional_assay_available: bool = False
    functional_assay_result: Optional[str] = None  # "pathogenic" | "benign" | "indeterminate"
    functional_assay_oddspath: Optional[float] = None

    # Step 8 — reanalysis cadence
    months_since_last_run: int = 0


@dataclass
class PipelineResult:
    variant_id: str
    classification: Classification = Classification.VUS
    terminal: str = ""
    evidence: list[EvidenceLine] = field(default_factory=list)
    trail: list[str] = field(default_factory=list)
    caveats: list[str] = field(default_factory=list)
    next_action: str = ""

    @property
    def standalone(self) -> bool:
        return any(e.is_standalone for e in self.evidence)

    @property
    def total_points(self) -> Optional[int]:
        return None if self.standalone else sum(e.points for e in self.evidence)

    @property
    def points_display(self) -> str:
        return "Stand-alone (BA1)" if self.standalone else f"{self.total_points:+d}"

    def add(self, code: str, strength: Strength, step: str, note: str = "") -> None:
        self.evidence.append(EvidenceLine(code, strength, step, note))

    def log(self, msg: str) -> None:
        self.trail.append(msg)

    def finish(self, classification: Classification, terminal: str, next_action: str = "") -> "PipelineResult":
        self.classification = classification
        self.terminal = terminal
        self.next_action = next_action
        self.caveats.extend(check_mutual_exclusivity(self.evidence))
        return self

    def report(self) -> str:
        lines = [
            f"Variant: {self.variant_id}",
            f"Final classification: {self.classification.value}  (points: {self.points_display})",
            f"Terminal: {self.terminal}",
        ]
        if self.evidence:
            lines.append("Evidence accumulated:")
            for e in self.evidence:
                detail = f" — {e.note}" if e.note else ""
                lines.append(f"  - {e.code} ({e.strength.label}, {e.points_display}) @ {e.step}{detail}")
        lines.append("Decision trail:")
        for i, step in enumerate(self.trail, 1):
            lines.append(f"  {i}. {step}")
        for c in self.caveats:
            lines.append(f"  ! {c}")
        if self.next_action:
            lines.append(f"Next action: {self.next_action}")
        return "\n".join(lines)


class VUSResolutionPipeline:
    """Eight-step escalation for a variant that scored VUS on baseline ACMG."""

    def run(self, case: VariantCase) -> PipelineResult:
        r = PipelineResult(variant_id=case.variant_id)
        r.log("START: VUS after baseline scoring -> Step 1 (re-annotate)")
        return self.step1_reannotate(case, r)

    # ---- STEP 1 — re-annotate ---------------------------------------
    def step1_reannotate(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 1: gnomAD frequency, calibrated predictors, ClinGen gene validity")

        freq_lines, freq_caveats = evaluate_frequency(case.frequency, case.disease, step="Step1")
        r.evidence.extend(freq_lines)
        r.caveats.extend(freq_caveats)

        if r.standalone:
            r.log("popmax AF above 5% -> BA1, terminal")
            return r.finish(Classification.BENIGN, "Downgraded (BA1)", "Remove from the candidate list")

        benign_strong = sum(1 for e in freq_lines if e.is_benign and e.strength is Strength.STRONG)
        if benign_strong >= 2:
            r.log("Two Strong benign frequency criteria -> Benign without further work")
            return r.finish(Classification.BENIGN, "Downgraded", "Remove from the candidate list")

        if not case.gene_validity.supports_classification:
            r.log(f"Gene-disease validity is {case.gene_validity.value} -> capped at VUS")
            return r.finish(
                Classification.VUS, "Parked (gene validity)",
                "Park pending ClinGen gene-disease re-curation",
            )

        r.log("Still uncertain -> Step 2 (molecular-class triage)")
        return self.step2_class_triage(case, r)

    # ---- STEP 2 — molecular class -----------------------------------
    def step2_class_triage(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        mc = case.molecular_class
        r.log(f"STEP 2: molecular class = {mc.value}")
        if mc == MolecularClass.TRUNCATING:
            return self.step3a_lof(case, r)
        if mc.is_protein_altering:
            return self.step3b_missense(case, r)
        if mc.is_splice_like:
            return self.step3c_splice(case, r)
        r.log("Unclassifiable consequence -> route on genotype alone")
        return self.step4_genotype(case, r)

    # ---- STEP 3a — PVS1 via the NMD decision tree --------------------
    def step3a_lof(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 3a: grade PVS1 (Abou Tayoun 2018 decision tree)")

        if not case.established_lof_mechanism:
            r.log("LoF is not an established mechanism for this gene -> PVS1 not applicable")
            r.caveats.append("PVS1 withheld: loss of function is not an established mechanism here.")
            return self.step4_genotype(case, r)

        if case.nmd_competent is None:
            r.log("NMD status unknown -> PVS1 withheld pending AutoPVS1")
            r.caveats.append("PVS1 withheld: NMD competence not determined. Run AutoPVS1.")
            return self.step4_genotype(case, r)

        if case.nmd_competent and not case.frame_preserving:
            r.add("PVS1", Strength.VERY_STRONG, "Step3a",
                  "NMD-competent region, established LoF mechanism")
            r.log("NMD-competent -> PVS1 Very Strong")
        elif case.removes_critical_region:
            r.add("PVS1", Strength.STRONG, "Step3a",
                  "NMD-escape but removes a region containing known pathogenic variants")
            r.log("NMD-escape, critical region removed -> PVS1 Strong")
        elif case.removes_critical_region is False:
            r.add("PVS1", Strength.SUPPORTING, "Step3a",
                  "NMD-escape, truncated region appears dispensable")
            r.log("NMD-escape, dispensable region -> PVS1 Supporting")
        else:
            r.add("PVS1", Strength.MODERATE, "Step3a",
                  "NMD-escape or frame-preserving; importance of the removed region unresolved")
            r.log("NMD-escape, region importance unknown -> PVS1 Moderate")

        return self.step4_genotype(case, r)

    # ---- STEP 3b — missense / in-frame -------------------------------
    def step3b_missense(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 3b: one calibrated predictor (Pejaver 2022 thresholds)")
        line, notes = evaluate_missense_insilico(case.insilico, step="Step3b")
        if line:
            r.evidence.append(line)
            r.log(f"{line.code} {line.strength.label} — {line.note}")
        r.caveats.extend(notes)
        return self.step4_genotype(case, r)

    # ---- STEP 3c — splice-like ---------------------------------------
    def step3c_splice(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 3c: splice prediction")
        line, notes = evaluate_splice_insilico(case.insilico, step="Step3c")
        r.caveats.extend(notes)

        if line:
            r.evidence.append(line)
            r.log(f"{line.code} {line.strength.label} — {line.note}")
            if line.code == "PP3":
                r.log("Splice-altering predicted -> escalate to RNA/minigene (Step 6)")
                return self.step6_functional(case, r)
        else:
            bp7, bp7_notes = evaluate_bp7(case.molecular_class, case.insilico, step="Step3c")
            r.caveats.extend(bp7_notes)
            if bp7:
                r.evidence.append(bp7)
                r.log("Synonymous, splice-quiet, not conserved -> BP7")

        return self.step4_genotype(case, r)

    # ---- STEP 4 — genotype triage ------------------------------------
    def step4_genotype(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        z = case.zygosity
        r.log(f"STEP 4: genotype triage — zygosity = {z.value if z else 'unspecified'}")
        if z == Zygosity.HOM_AR:
            return self.step5a_roh(case, r)
        if z == Zygosity.COMP_HET_AR:
            return self.step5b_phase(case, r)
        if z == Zygosity.SINGLE_HET_AR:
            return self.step5c_second_allele(case, r)
        if z in (Zygosity.HET_DOMINANT, Zygosity.HEMI_XL_MALE):
            return self.step5d_segregation(case, r)
        r.log("Zygosity unspecified -> cannot route further")
        return r.finish(Classification.VUS, "Parked (genotype unresolved)",
                        "Confirm zygosity and re-run from Step 4")

    # ---- STEP 5a — autozygosity mapping ------------------------------
    def step5a_roh(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5a: runs of homozygosity (AutoMap; Quinodoz 2021)")
        if case.in_roh and case.roh_length_mb >= 1.5:
            r.log(f"Homozygous variant sits in a {case.roh_length_mb:.2f} Mb ROH -> locus prioritised")
            return self.step5d_segregation(case, r)
        r.log("Not in an ROH — consider a CNV masking apparent homozygosity")
        r.caveats.append("Apparent homozygosity outside an ROH can be a deletion in trans. Check read depth.")
        return self.step5c_second_allele(case, r)

    # ---- STEP 5b — phasing -------------------------------------------
    def step5b_phase(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5b: phasing — PM3 requires a confirmed trans configuration")

        if case.phase_result == "cis":
            r.add("BP2", Strength.SUPPORTING, "Step5b", "confirmed in cis with the second variant")
            r.log("In cis -> biallelic hypothesis rejected, BP2 applied")
            return self.step5c_second_allele(case, r)

        if case.phase_result == "trans":
            if case.trans_allele_is_pathogenic:
                r.add("PM3", Strength.MODERATE, "Step5b",
                      "confirmed trans with a P/LP allele (SVI 1.0 point)")
                r.log("Confirmed trans with a pathogenic allele -> PM3 Moderate")
            else:
                r.add("PM3", Strength.SUPPORTING, "Step5b",
                      "confirmed trans, second allele not yet P/LP (SVI 0.5 point)")
                r.log("Confirmed trans with a non-P/LP allele -> PM3 Supporting")
            return self.step6_functional(case, r)

        if case.parents_available:
            r.log("Parents available -> trio phasing pending")
        elif case.reads_shared_for_phasing:
            r.log("Variants share reads -> read-backed phasing (WhatsHap) pending")
        else:
            r.log("No parents and no shared reads -> cannot phase")
            return r.finish(Classification.VUS, "Parked (unphased compound het)",
                            "Obtain parental samples, or long-read / read-backed phasing")

        return r.finish(Classification.VUS, "Parked (phasing pending)",
                        "Complete trio or read-backed phasing, then re-run from Step 5b")

    # ---- STEP 5c — second-allele hunt --------------------------------
    def step5c_second_allele(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5c: second-allele hunt, cheapest escalation first")

        if case.cnv_found:
            if case.cnv_is_null:
                r.log("Exon-level null CNV found as the second allele")
                r.caveats.append(
                    "PVS1 for the CNV belongs to that allele's own record, not to this variant. "
                    "Here it counts as the confirmed second hit for PM3."
                )
            r.log("Second allele identified -> confirm phase")
            return self.step5b_phase(case, r)

        if case.wgs_deep_intronic_found:
            r.log("WGS found a deep-intronic or structural second allele -> confirm by RNA")
            return self.step6_functional(case, r)

        if case.complex_sv_locus:
            if case.long_read_resolved:
                r.add("PM3", Strength.MODERATE, "Step5c",
                      "breakpoints and phase resolved by long-read sequencing")
                r.log("Complex locus resolved by long reads -> phase established")
                return self.step6_functional(case, r)
            r.log("Complex SV locus unresolved")
            return r.finish(Classification.VUS, "Parked (awaiting long-read)",
                            "Order long-read sequencing for this locus (e.g. RPGR-ORF15)")

        if case.phenotype_strongly_matches_gene and case.wgs_deep_intronic_found is None:
            r.log("CNV-negative with a strong phenotype match -> escalate to WGS")
            return r.finish(Classification.VUS, "Parked (awaiting WGS)",
                            "WGS for deep-intronic and structural alleles (e.g. ABCA4, USH2A)")

        r.log("All second-allele avenues exhausted")
        return self.step8_scheduled_reanalysis(case, r, from_step="Step5c")

    # ---- STEP 5d — segregation and de novo ---------------------------
    def step5d_segregation(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 5d: segregation and de novo analysis")

        if case.apparent_de_novo:
            # ClinGen SVI de novo point scale, weighted by phenotype specificity.
            specific = case.phenotype_specificity
            if case.de_novo_confirmed:
                strength = {"specific": Strength.STRONG,
                            "consistent": Strength.MODERATE}.get(specific, Strength.SUPPORTING)
                r.add("PS2", strength, "Step5d",
                      f"de novo confirmed by parentage testing; phenotype {specific}")
                r.log(f"Confirmed de novo -> PS2 {strength.label}")
            else:
                strength = {"specific": Strength.MODERATE,
                            "consistent": Strength.SUPPORTING}.get(specific, Strength.SUPPORTING)
                r.add("PM6", strength, "Step5d",
                      f"assumed de novo, parentage unconfirmed; phenotype {specific}")
                r.log(f"Assumed de novo -> PM6 {strength.label}")
            return self.step6_functional(case, r)

        if case.segregates_with_disease is True:
            # Jarvik & Browning 2016: ~3 meioses Supporting, ~5 Moderate, ~7 Strong.
            m = case.informative_meioses
            if m >= 7:
                strength = Strength.STRONG
            elif m >= 5:
                strength = Strength.MODERATE
            elif m >= 3:
                strength = Strength.SUPPORTING
            else:
                r.log(f"Only {m} informative meioses — below the threshold for PP1")
                r.caveats.append(f"PP1 withheld: {m} informative meioses, fewer than the 3 needed.")
                return self.step6_functional(case, r)
            r.add("PP1", strength, "Step5d", f"cosegregates across {m} informative meioses")
            r.log(f"Segregation over {m} meioses -> PP1 {strength.label}")
            return self.step6_functional(case, r)

        if case.segregates_with_disease is False:
            r.add("BS4", Strength.STRONG, "Step5d", "fails to track with disease in the pedigree")
            r.caveats.append(
                "Before accepting BS4, exclude phenocopy, reduced penetrance, non-paternity "
                "and a second aetiology in the family."
            )
            r.log("Fails to segregate -> BS4")
            return self.step7_recombine(case, r)

        r.log("No segregation or de novo data -> continue to functional evidence")
        return self.step6_functional(case, r)

    # ---- STEP 6 — functional / RNA evidence --------------------------
    def step6_functional(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        r.log("STEP 6: functional evidence (converts prediction into PS3/BS3)")

        if not case.functional_assay_available:
            r.log("No assay available")
            r.caveats.append(
                "PS3/BS3 not assessed. For a predicted splice variant, an RNA or minigene "
                "assay is usually the cheapest route out of VUS."
            )
            return self.step7_recombine(case, r)

        odds = case.functional_assay_oddspath
        result = case.functional_assay_result

        if result == "pathogenic":
            # Brnich 2020 OddsPath scale.
            if odds is None:
                strength, note = Strength.SUPPORTING, "assay not OddsPath-calibrated; capped at Supporting"
            elif odds > 18.7:
                strength, note = Strength.STRONG, f"OddsPath {odds:.1f} > 18.7"
            elif odds > 4.3:
                strength, note = Strength.MODERATE, f"OddsPath {odds:.1f} > 4.3"
            elif odds > 2.1:
                strength, note = Strength.SUPPORTING, f"OddsPath {odds:.1f} > 2.1"
            else:
                r.log(f"OddsPath {odds:.1f} is below the threshold for any evidence strength")
                return self.step7_recombine(case, r)
            r.add("PS3", strength, "Step6", note)
            r.log(f"Damaging assay -> PS3 {strength.label}")

        elif result == "benign":
            if odds is None:
                strength, note = Strength.SUPPORTING, "assay not OddsPath-calibrated; capped at Supporting"
            elif odds < 0.053:
                strength, note = Strength.STRONG, f"OddsPath {odds:.3f} < 0.053"
            elif odds < 0.23:
                strength, note = Strength.MODERATE, f"OddsPath {odds:.3f} < 0.23"
            elif odds < 0.48:
                strength, note = Strength.SUPPORTING, f"OddsPath {odds:.3f} < 0.48"
            else:
                r.log(f"OddsPath {odds:.3f} is above the threshold for any benign strength")
                return self.step7_recombine(case, r)
            r.add("BS3", strength, "Step6", note)
            r.log(f"Normal-function assay -> BS3 {strength.label}")

        else:
            r.log("Assay indeterminate -> no PS3/BS3")

        return self.step7_recombine(case, r)

    # ---- STEP 7 — recombine ------------------------------------------
    def step7_recombine(self, case: VariantCase, r: PipelineResult) -> PipelineResult:
        conflicts = check_mutual_exclusivity(r.evidence)
        if conflicts:
            r.caveats.extend(conflicts)

        has_p = any(not e.is_benign and e.strength in (Strength.VERY_STRONG, Strength.STRONG)
                    for e in r.evidence)
        has_b = any(e.is_benign and e.strength in (Strength.VERY_STRONG, Strength.STRONG)
                    for e in r.evidence)
        if has_p and has_b:
            r.log("Strong evidence on both sides -> genuine conflict, reported as VUS")
            r.caveats.append(
                "Conflicting strong evidence. Report as VUS with the conflict stated; "
                "do not net the points to zero and call it VUS by default."
            )
            return r.finish(Classification.VUS, "Conflicting evidence",
                            "Adjudicate the conflicting lines before re-scoring")

        total = r.total_points or 0
        r.log(f"STEP 7: Tavtigian points total = {total:+d}")
        cls = classify_from_points(total)

        if cls in (Classification.PATHOGENIC, Classification.LIKELY_PATHOGENIC):
            if not case.gene_validity.supports_classification:
                r.log("Gene validity below Moderate -> capped at VUS despite the point total")
                return r.finish(Classification.VUS, "Capped (gene validity)",
                                "Park pending ClinGen gene-disease re-curation")
            caveat = "" if cls is Classification.PATHOGENIC else " (state the genotype-completeness caveat)"
            return r.finish(cls, "Solved / upgraded", f"Report{caveat}")

        if cls in (Classification.BENIGN, Classification.LIKELY_BENIGN):
            return r.finish(cls, "Downgraded", "Remove from the candidate list")

        return self.step8_scheduled_reanalysis(case, r, from_step="Step7")

    # ---- STEP 8 — scheduled reanalysis -------------------------------
    def step8_scheduled_reanalysis(self, case: VariantCase, r: PipelineResult,
                                   from_step: str) -> PipelineResult:
        r.log(f"STEP 8: still VUS at {from_step} -> scheduled reanalysis queue")
        if case.months_since_last_run >= 12:
            r.log("12 months elapsed -> re-running from Step 1")
            fresh = VariantCase(**{**case.__dict__, "months_since_last_run": 0})
            return self.step1_reannotate(fresh, r)
        remaining = max(0, 12 - case.months_since_last_run)
        return r.finish(Classification.VUS, "Parked (scheduled reanalysis)",
                        f"Re-run from Step 1 in {remaining} month(s), or sooner on a "
                        "ClinVar, gnomAD or ClinGen update")


